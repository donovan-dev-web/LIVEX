import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../utils/url';
import { MONOGRAPH_GROUPS, MONOGRAPH_REPO, MONOGRAPH_TREE } from '../data/monograph';

const groups = MONOGRAPH_GROUPS.map((group) => ({
  title: group.title.fr,
  items: group.items.map((item) => ({ label: item.label.fr, href: item.href })),
}));
---
<BaseLayout
  title="LIVEX - Monographie : chapitres et sommaire"
  description="La monographie de LIVEX, chapitre par chapitre : moteur SYNE, observation ECHOS, rendu PRISM, Launcher, résultats et annexes."
>
  <PageHeader
    index="15b"
    eyebrow="Documentation"
    title="La monographie, chapitre par chapitre."
    lead="La monographie vit dans le dépôt, versionnée avec le code. Ce portail en rapproche les chapitres, classés par intention, pour aller droit au but."
    crumbs={[{ label: 'Documentation', href: 'documentation/' }, { label: 'Monographie' }]}
  />

  <section class="block">
    <div class="w">
      <h2>Les chapitres, par bloc.</h2>
      <p>Chaque lien ouvre le fichier Markdown correspondant sur GitHub. Le sommaire général reste la référence.</p>
      <p style="margin-top:18px">
        <a class="bt" href={`${MONOGRAPH_REPO}/00-SOMMAIRE-GENERAL.md`} rel="noopener">Sommaire général ↗</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={MONOGRAPH_TREE} rel="noopener">Dossier complet ↗</a>
      </p>
      <div class="g2" style="margin-top:20px">
        {groups.map((g) => (
          <div class="pl br" style="padding:20px">
            <h3 style="margin-bottom:10px">{g.title}</h3>
            <ul style="list-style:none;padding:0;margin:0">
              {g.items.map((it) => (
                <li style="padding:4px 0;font-size:0.8rem">
                  <a href={it.href} rel="noopener">{it.label} ↗</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="cc" style="margin-top:24px"><p>Dossier complet :
        <a href={MONOGRAPH_TREE} rel="noopener">docs/monographie/</a>.
        Pour une vue courte : <a href={url('documentation/')}>Documentation</a> et
        <a href={url('technique/')}>Architecture</a>.</p></div>
    </div>
  </section>
</BaseLayout>
