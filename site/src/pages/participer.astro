---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const repo = 'https://github.com/donovan-dev-web/LIVEX';
const blob = `${repo}/blob/main`;
---
<BaseLayout
  title="Participer"
  description="Contribuer à LIVEX : règles de contribution, code de conduite, signalement de sécurité et support. Le dépôt est public sous licence MIT."
>
  <PageHeader
    index="19"
    eyebrow="Participer"
    title="Contribuer, dans les règles."
    lead="Le dépôt est public sous licence MIT. Un projet solo accueille volontiers les contributions, à condition de respecter un cadre simple."
    crumbs={[{ label: 'Participer' }]}
  />

  <section class="block">
    <div class="w">
      <div class="g2">
        <div class="pl br" style="padding:20px">
          <h3>Contribuer</h3>
          <p class="mu">Branches, messages de commit, périmètre des PR. Lisez ce document avant votre première contribution.</p>
          <a class="bt" href={`${blob}/CONTRIBUTING.md`} rel="noopener">CONTRIBUTING.md ↗</a>
        </div>
        <div class="pl br" style="padding:20px">
          <h3>Code de conduite</h3>
          <p class="mu">Les échanges se tiennent dans un cadre respectueux. Il s'applique à toutes les interactions du projet.</p>
          <a class="bt" href={`${blob}/CODE_OF_CONDUCT.md`} rel="noopener">CODE_OF_CONDUCT.md ↗</a>
        </div>
        <div class="pl br" style="padding:20px">
          <h3>Sécurité</h3>
          <p class="mu">Signalez toute vulnérabilité de façon privée, avant toute discussion publique.</p>
          <a class="bt" href={`${blob}/SECURITY.md`} rel="noopener">SECURITY.md ↗</a>
        </div>
        <div class="pl br" style="padding:20px">
          <h3>Support</h3>
          <p class="mu">Où poser une question, ouvrir une issue, ou trouver de l'aide.</p>
          <a class="bt" href={`${blob}/SUPPORT.md`} rel="noopener">SUPPORT.md ↗</a>
        </div>
      </div>

      <div class="cc" style="margin-top:26px">
        <p><strong>Signaler une vulnérabilité :</strong> ouvrez un avis privé via
          <a href={`${repo}/security/advisories/new`} rel="noopener">GitHub Security Advisories</a> — n'exposez pas la
          faille en issue publique.</p>
      </div>
    </div>
  </section>
</BaseLayout>
