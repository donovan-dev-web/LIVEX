import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { PROJECT_STATE, RELEASE } from '../data/release';
import { url } from '../utils/url';
import { SITE } from '../data/site';
---
<BaseLayout
  title="À propos — origine, vision et faits datés"
  description="Origine de LIVEX, vision de son auteur et faits datés du projet : un projet de recherche personnel en simulation multi-agents, avec SYNE, ECHOS et PRISM."
>
  <PageHeader
    index="20"
    eyebrow="À propos"
    title="D'où vient LIVEX."
    lead="LIVEX est né d'une question, pas d'un plan. Voici, dans les mots de son auteur, ce qu'il cherche à explorer — et l'état réel du projet, daté."
    crumbs={[{ label: 'À propos' }]}
  />

  <section class="block">
    <div class="w">
      <blockquote class="sf" style="font-size:clamp(1.6rem,3.5vw,2.6rem);line-height:1.3;margin:0 0 24px;border-left:2px solid var(--ve);padding-left:22px;max-width:34ch">
        Peut-on construire un environnement virtuel régi par des lois fondamentales, au sein duquel des entités
        autonomes produisent des comportements et des structures qui n'ont pas été explicitement programmés ?
      </blockquote>
      <p>
        C'est la question qui a donné naissance à LIVEX. Avant d'être un projet de développement, LIVEX est né d'une
        curiosité pour les mondes de la science-fiction et du LitRPG : des mondes qui paraissent vivants parce que
        leurs entités ont des besoins, des perceptions et la capacité de décider.
      </p>
      <p>
        Je suis développeur et infographiste 3D. Mon parcours m'a conduit aux deux faces d'un même problème :
        comment représenter un monde, et comment construire ce qui le fait fonctionner. LIVEX est né de cette
        rencontre entre création visuelle, développement et curiosité pour les systèmes complexes.
      </p>
      <p>
        Ma vision est simple : ne pas programmer les comportements que je souhaite observer, mais construire
        l'environnement et les lois qui peuvent leur permettre d'émerger. Et si quelque chose d'intéressant apparaît,
        il ne suffit pas de le montrer — il faut pouvoir l'observer, le mesurer, l'analyser et, autant que possible,
        le reproduire.
      </p>
      <p>
        Concrètement, cela donne trois briques complémentaires : <strong>SYNE</strong>, le moteur qui tient la vérité
        du monde ; <strong>ECHOS</strong>, qui observe et analyse ce qui s'y passe ; et <strong>PRISM</strong>, qui
        restitue le monde sans jamais en être la source. L'ensemble est documenté et mesuré plutôt que promis.
      </p>
      <p class="sf" style="font-size:1.5rem;margin-top:20px">— Donovan Chartrain</p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>20.1</b> Le projet en bref</div>
      <h2>Des faits, pas des slogans.</h2>
      <p class="mu">
        Les valeurs ci-dessous sont datées et proviennent de la source unique du site ; elles décrivent l'état du
        dépôt, pas une promesse de publication.
      </p>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Élément</th><th scope="col">Valeur</th></tr></thead>
          <tbody>
            <tr><td>Nature</td><td>Projet de recherche personnel en simulation multi-agents</td></tr>
            <tr><td>Composants</td><td>SYNE (moteur) · ECHOS (observation) · PRISM (rendu)</td></tr>
            <tr><td>Licence</td><td>GPL-3.0-or-later (code LIVEX hors PRISM) · CC BY 4.0 (contenu du site)</td></tr>
            <tr><td>Dépôt</td><td><a href="https://github.com/donovan-dev-web/LIVEX" rel="noopener">github.com/donovan-dev-web/LIVEX ↗</a></td></tr>
            <tr><td>État</td><td>Aucune version publique — version cible {RELEASE.planned}</td></tr>
            <tr><td>Dernier état mesuré</td><td>{PROJECT_STATE.observedDate}</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top:20px">
        <a class="bt" href={url('comprendre/')}>Comprendre LIVEX</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={url('documentation/')}>Documentation</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={url('a-propos/transparence-ia/')}>Transparence IA</a>
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>20.2</b> Qui est derrière LIVEX</div>
      <h2>Un projet porté par une seule personne.</h2>
      <p>
        LIVEX est un projet personnel, porté par Donovan Chartrain. La page
        <a href={url('a-propos/auteur/')}>Auteur</a> présente son parcours, ses compétences et ses autres projets.
      </p>
      <p style="margin-top:18px">
        <a class="bt" href={url('a-propos/auteur/')}>Découvrir l'auteur →</a>
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>20.3</b> Citer ce projet</div>
      <h2>Une référence stable pour vos travaux.</h2>
      <p class="mu">
        LIVEX est citable via le fichier <code>CITATION.cff</code> du dépôt. Formats ci-dessous.
      </p>
      <div class="ov" style="margin-top:18px">
        <pre><code>@software{'{'}chartrain2026livex,
  author = {'{'}Chartrain, Donovan{'}'},
  title = {'{'}LIVEX: Living Intelligent Virtual Ecosystem eXperience{'}'},
  year = {'{'}2026{'}'},
  url = {'{'}https://github.com/donovan-dev-web/LIVEX{'}'},
  version = {'{'}0.1{'}'},
  license = {'{'}GPL-3.0-or-later{'}'}
{'}'}</code></pre>
      </div>
      <p style="margin-top:14px;font-size:0.85rem">
        <strong>APA :</strong> Chartrain, D. (2026). <em>LIVEX: Living Intelligent Virtual Ecosystem eXperience</em>
        (Version 0.1) [Software]. https://github.com/donovan-dev-web/LIVEX
      </p>
      <p style="margin-top:12px">
        <a class="bt" href={url('CITATION.cff')} rel="noopener">Télécharger CITATION.cff →</a>
      </p>
    </div>
  </section>

  <CtaBand
    eyebrow="20.4 – Conversion"
    title="Suivre le projet et son auteur"
    lead="Le dépôt, le journal et les portfolios sont les points d'entrée pour aller plus loin."
    primaryLabel="Dépôt GitHub ↗"
    primaryHref={SITE.repo}
    secondaryLabel="Suivre le projet"
    secondaryHref="suivre/"
  />
</BaseLayout>
