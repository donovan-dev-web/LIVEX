import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { url } from '../../utils/url';
---
<BaseLayout
  title="Comprendre LIVEX — méthode et limites"
  description="Ce qu'est LIVEX, sa méthode (déterministe, séparée, documentée) et ses limites assumées : un projet de recherche en simulation multi-agents."
>
  <PageHeader
    index="01"
    eyebrow="Comprendre"
    title="Une archive vivante d'un monde simulé."
    lead="LIVEX part d'une question simple : peut-on rendre observable un comportement collectif que personne n'a programmé à la main ? Ce que le projet produit n'est pas une histoire, mais un relevé."
    crumbs={[{ label: 'Comprendre' }]}
  />

  <section class="block">
    <div class="w">
      <div class="sh"><b>1.1</b> Le problème</div>
      <h2>Comprendre sans scénariser.</h2>
      <p>
        Beaucoup de simulations se contentent de jouer une séquence prévue. On y voit ce qu'on y a mis. LIVEX vise
        l'inverse : poser des agents, des règles et un environnement, puis <strong>laisser faire</strong> et enregistrer
        ce qui se produit — y compris l'inattendu, y compris ce qui ne fonctionne pas.
      </p>
      <p>Cela impose deux exigences :</p>
      <ul style="margin:8px 0 0 20px;color:var(--mu);font-size:0.9rem;line-height:1.7">
        <li><strong>Déterminisme</strong> — à partir de la même graine, un run se rejoue à l'identique, tick après tick.</li>
        <li><strong>Séparation</strong> — ce qui se passe (le moteur) et ce qu'on en dit (l'observation) ne se confondent jamais, sous peine de raconter ce qu'on espérait voir.</li>
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>1.2</b> La méthode</div>
      <h2>Trois temps, trois composants.</h2>
      <div class="g3 br">
        <div>
          <div class="n">01</div>
          <h3>Simuler</h3>
          <p><strong>SYNE</strong> fait tourner le monde : agents, ressources, règles. Chaque run est rejouable à
            l'identique et horodaté par une graine.</p>
        </div>
        <div>
          <div class="n">02</div>
          <h3>Observer</h3>
          <p><strong>ECHOS</strong> ingère les traces et en tire des mesures : viabilité, motifs, boucles. Il observe
            sans intervenir sur le monde.</p>
        </div>
        <div>
          <div class="n">03</div>
          <h3>Rendre visible</h3>
          <p><strong>PRISM</strong> donne à voir le monde et sa dynamique, par le rendu et l'interaction.</p>
        </div>
      </div>
      <div class="cc" style="margin-top:20px"><p><strong>Le produit s'installe aussi.</strong> L'installateur LIVEX est le composant de distribution : il déploie le socle et PRISM, puis gère les mises à jour, réparations et désinstallations sous Windows et Linux. <a href={url('technique/installer/')}>Découvrir l'installateur →</a></p></div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>1.3</b> Ce que LIVEX n'est pas</div>
      <h2>Des limites que l'on assume.</h2>
      <div class="cc">
        <p>
          Les agents de LIVEX ne sont ni conscients, ni des personnes, ni des modèles de sociétés réelles. Ce sont des
          entités <strong>simulées</strong>, dont les « émotions » ou « intentions » sont des variables, pas des états
          mentaux. LIVEX ne prétend ni prédire, ni reproduire le réel.
        </p>
      </div>
      <p>
        La release publique LIVEX 1.0.0 est disponible. Les états des composants et les limites d'usage sont décrits
        dans la documentation et les rapports datés.
      </p>
      <div class="toc" style="margin-top:22px">
        <a href={url('comprendre/limites/')}>Limites et portée →</a>
        <a href={url('comprendre/emergence/')}>L'émergence expliquée →</a>
        <a href={url('comprendre/glossaire/')}>Glossaire →</a>
        <a href={url('technique/')}>Architecture →</a>
        <a href={url('faq/')}>FAQ →</a>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="1.4 · Conversion"
    title="Aller plus loin"
    lead="La technique, la documentation et le dépôt prolongent cette présentation."
    primaryLabel="Explorer la technique"
    primaryHref="technique/"
    secondaryLabel="Documentation"
    secondaryHref="documentation/"
  />
</BaseLayout>
