---
// SPDX-FileCopyrightText: 2026 Donovan Chartrain
// SPDX-License-Identifier: GPL-3.0-or-later

import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import HeroFigure from '../components/HeroFigure.astro';
import CtaBand from '../components/CtaBand.astro';
import CardLink from '../components/CardLink.astro';
import { SITE } from '../data/site';
import { COMPONENTS } from '../data/components';
import { PROJECT_STATE, RELEASE } from '../data/release';
import { getCollection } from 'astro:content';
import echosAgents from '../assets/captures/echos-agents.png';
import launcherHome from '../assets/captures/launcher-home.png';
import launcherPrism from '../assets/captures/launcher-prism.png';
import { Image } from 'astro:assets';
import { url } from '../utils/url';

const nf = new Intl.NumberFormat('fr-FR');
const coverageEchos = PROJECT_STATE.coverage.echos.replace('.', ',').replace('%', ' %');
const latestArticles = (await getCollection('actualites', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const articleFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'ScientificApplication',
  operatingSystem: 'Cross-platform',
  description: SITE.description,
  url: new URL(url(''), Astro.site).href,
  author: { '@type': 'Person', name: SITE.author },
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  codeRepository: SITE.repo,
};
---
<BaseLayout
  title="LIVEX — simulation multi-agents déterministe"
  description="Moteur déterministe SYNE, observation ECHOS, rendu PRISM : une plateforme de recherche en simulation multi-agents, reproductible et documentée."
  jsonLd={softwareJsonLd}
>
  <div class="w">
    <!-- Héros -->
    <section class="hero">
      <div>
        <p class="ey">Living Intelligent Virtual Ecosystem eXperience</p>
        <h1>Observer ce qui <i>émerge.</i></h1>
        <p class="l">
          Une plateforme expérimentale de simulation multi-agents, du moteur qui fait vivre le monde jusqu'à sa
          représentation 3D : trois couches séparées, des règles explicites, des résultats à observer.
        </p>
        <div class="hero-badges" style="display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px">
          <span class="badge br" style="font-size:0.78rem;padding:4px 10px">Version cible {RELEASE.planned}</span>
          <span class="badge br" style="font-size:0.78rem;padding:4px 10px">{SITE.license}</span>
          <span class="badge br" style="font-size:0.78rem;padding:4px 10px">{nf.format(PROJECT_STATE.tests.passed)} tests au vert</span>
          <span class="badge br" style="font-size:0.78rem;padding:4px 10px">Couverture ECHOS {coverageEchos}</span>
        </div>
        <div class="cta">
          <a class="bt p" href={url('technique/prism/')}>Voir la démo</a>
          <a class="bt" href={url('documentation/')}>Lire la documentation</a>
          <a class="bt" href={url('participer/')}>Contribuer</a>
        </div>
      </div>

      <HeroFigure lang="fr" />
    </section>

    <!-- Bandeau d'état -->
    <div class="vs br" style="padding-left:16px;padding-right:16px;border:1px solid var(--ln)">
      <StatusBadge status="developpement" label={RELEASE.plannedLabel} />
      <p>
        Aucune version publique n'est téléchargeable à ce jour. L'état des composants décrit ci-dessous reflète le
        <strong> dépôt de développement</strong>, et non une distribution. Voir la page <a href={url('versions/')}>Versions</a>.
      </p>
    </div>
  </div>

  <!-- Par où commencer -->
  <section class="block">
    <div class="w">
      <div class="sh"><b>00</b> Par où commencer</div>
      <h2>Un chemin selon votre question.</h2>
      <p class="lead">
        LIVEX parle à plusieurs publics. Choisissez l'entrée qui correspond à votre question : le site garde ensuite la
        même méthode (déterministe, séparée, documentée) à tous les niveaux.
      </p>
      <div class="g3 br" style="margin-top:28px">
        <CardLink
          title="Comprendre le projet"
          text="Ce qu'est LIVEX, sa méthode et ce qu'il n'est pas. Le meilleur point d'entrée pour une première lecture."
          href="comprendre/"
          cta="Lire la présentation →"
        />
        <CardLink
          title="Vérifier la technique"
          text="Architecture en trois couches, moteur, observation, rendu. Des preuves et des statuts plutôt que des promesses."
          href="technique/"
          cta="Explorer l'architecture →"
        />
        <CardLink
          title="Suivre et contribuer"
          text="Canaux, journal daté, contribution, signalement. Le projet est public et accueille les retours."
          href="suivre/"
          cta="Suivre le projet →"
        />
      </div>
    </div>
  </section>

  <!-- Pourquoi LIVEX -->
  <section class="block">
    <div class="w">
      <div class="sh"><b>00b</b> Pourquoi LIVEX</div>
      <h2>Trois raisons de s'y attarder.</h2>
      <p class="lead">
        Le projet ne vend pas une promesse : il rend observable ce qui se passe, avec les preuves qui vont avec.
      </p>
      <div class="g3 br" style="margin-top:28px">
        <CardLink
          title="Déterminisme"
          text="Le même point de départ rejoue le même run, bit à bit. Les résultats sont reproductibles, pas racontés."
          href="technique/resultats/"
          cta="Voir les mesures →"
        />
        <CardLink
          title="Observation indépendante"
          text="Simuler, mesurer, rendre visible : trois couches séparées, reliées par des contrats explicites."
          href="technique/echos/"
          cta="Découvrir ECHOS →"
        />
        <CardLink
          title="Contrats versionnés"
          text="Les interfaces publiques sont figées et versionnées (snapshot 0.5.0). Le contrat précède le rendu."
          href="technique/syne/"
          cta="Lire le contrat →"
        />
      </div>
    </div>
  </section>

  <!-- Ce qu'est LIVEX -->
  <section class="block">
    <div class="w">
      <div class="sh"><b>01</b> Le constat</div>
      <h2>Rendre lisible ce que personne n'a écrit.</h2>
      <p class="lead">
        LIVEX cherche à rendre observable un comportement collectif qui n'a pas été programmé à la main. Sa méthode tient
        en deux exigences : un moteur <strong>déterministe</strong> (le même point de départ rejoue le même run, bit à
        bit) et une <strong>séparation nette</strong> entre ce qui se passe (le moteur) et ce qu'on en dit (l'observation).
      </p>
      <ul style="margin:16px 0 0 20px;color:var(--mu);font-size:0.88rem;line-height:1.7">
        <li><strong>Déterministe</strong> — même graine, même configuration, même trajectoire.</li>
        <li><strong>Séparé</strong> — simuler, mesurer, rendre visible : trois couches indépendantes.</li>
        <li><strong>Documenté</strong> — chaque chiffre publié a une source interne datée.</li>
      </ul>
      <div class="g3 br" style="margin-top:28px">
        <div>
          <div class="n">03</div>
          <h3>composants</h3>
          <p>Un moteur, un système d'observation, un module de rendu — indépendants, reliés par des contrats explicites.</p>
        </div>
        <div>
          <div class="n">00</div>
          <h3>version publique</h3>
          <p>Le projet est passé en V0.2. Aucune release publique ni tag n'est posé à ce jour.</p>
        </div>
        <div>
          <div class="n">{nf.format(PROJECT_STATE.tests.passed)}</div>
          <h3>tests au vert</h3>
          <p>Au {PROJECT_STATE.observedDate}, 0 échec sur les suites locales. Un chiffre de méthode, pas une promesse.</p>
        </div>
      </div>

      <div class="fm" style="margin-top:36px">
        monde <span>SYNE · simule</span> traces <span>ECHOS · mesure</span> compréhension <span>PRISM · rend visible</span> <span class="q">→</span>
      </div>
    </div>
  </section>

  <!-- Architecture -->
  <section class="block" id="architecture">
    <div class="w">
      <div class="sh"><b>02</b> Architecture</div>
      <h2>Trois composants, des contrats explicites.</h2>

      {COMPONENTS.map((c) => (
        <div class="bn">
          <div>
            <span class="k">{c.acronym}</span>
            <h3>{c.name}</h3>
          </div>
          <div>
            <p>{c.summary}</p>
            <p style="margin:0 0 12px"><StatusBadge status={c.status.id} /></p>
            <a class="bt" href={url(c.href)} aria-label={`Détails sur ${c.name}`}>Détails →</a>
          </div>
          {c.key === 'syne' && <Image src={launcherHome} alt="Aperçu du Launcher LIVEX" style="width:100%;height:auto" loading="lazy" />}
          {c.key === 'echos' && <Image src={echosAgents} alt="Aperçu d'ECHOS : suivi d'agents" style="width:100%;height:auto" loading="lazy" />}
          {c.key === 'prism' && <Image src={launcherPrism} alt="Aperçu du rendu PRISM" style="width:100%;height:auto" loading="lazy" />}
        </div>
      ))}

      <div class="ct">Contrats d'interface publics — snapshot 0.5.0 · run_id « run-&lt;seed&gt;-&lt;12hex&gt; » · schéma de persistance v5</div>
      <p class="mu" style="font-size:0.7rem">Captures issues de la version de développement (relevé du {PROJECT_STATE.observedDate}). Elles documentent l'interface, sans constituer une démonstration de la version publiée.</p>
    </div>
  </section>

  <!-- Journal -->
  <section class="block">
    <div class="w">
      <div class="sh"><b>03</b> Journal</div>
      <h2>Ce qui bouge, daté.</h2>
      <p class="lead">Le journal consigne les jalons et les décisions techniques, avec leur date. Les articles de fond arrivent progressivement.</p>
      <div class="row">
        <span class="mu">{PROJECT_STATE.observedDate}</span>
        <span class="t"><a href={url('actualites/')}>État du dépôt et des composants : versions, tests, couverture.</a></span>
        <span><StatusBadge status="experimental" label="En cours" /></span>
      </div>
      {latestArticles.length > 0 && (
        <>
          <p class="mu" style="margin:22px 0 8px;font-size:0.78rem">Derniers jalons publiés :</p>
          {latestArticles.map((e) => (
            <div class="row">
              <span class="mu">{articleFmt.format(e.data.date)}</span>
              <span class="t"><a href={url(`actualites/${e.id}/`)}>{e.data.title}</a></span>
              <span><StatusBadge status="experimental" label="Publié" /></span>
            </div>
          ))}
        </>
      )}
      <p style="margin-top:18px"><a class="bt" href={url('actualites/')}>Voir le journal →</a></p>
    </div>
  </section>

  <CtaBand
    eyebrow="04 · Conversion"
    title="Suivez LIVEX, à votre rythme."
    lead="Le site est la source durable ; GitHub, le lieu de la transparence technique. Aucun compte, aucun cookie, aucun traceur — juste des liens."
    primaryLabel="Suivre le projet"
    primaryHref="suivre/"
    secondaryLabel="Dépôt GitHub ↗"
    secondaryHref={SITE.repo}
  />

  <!-- Prudence -->
  <section class="block">
    <div class="w">
      <div class="cc br" style="padding:18px 20px">
        <p>
          <strong>Note de méthode.</strong> LIVEX publie ses limites aussi volontiers que ses résultats. Les états
          (<em>disponible, expérimental, en développement, envisagé, hors périmètre</em>) décrivent le dépôt, jamais une
          intention. Aucune affirmation du site n'est publiée sans source interne datée.
        </p>
      </div>
      <div class="ct" style="border:0;margin-top:28px">
        <a class="bt p" href={url('comprendre/')}>Lire la présentation</a>
        <span style="display:inline-block;width:10px"></span>
        <a class="bt" href={SITE.repo} rel="noopener">Dépôt GitHub ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
