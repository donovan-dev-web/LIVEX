import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { RELEASE } from '../../data/release';
import { url } from '../../utils/url';
---
<BaseLayout
  title="LIVEX — Télécharger : releases et installation"
  description="Télécharger LIVEX : aucune release publique à ce jour, V0.2 en préparation. État des versions, installation depuis les sources et dépôt GitHub."
>
  <PageHeader
    index="11"
    eyebrow="Télécharger"
    title="Rien à télécharger, pour l'instant."
    lead="Pas de binaire à télécharger aujourd'hui : la V0.2 est en préparation. Voici ce qui existe, ce qui est prévu, et par où commencer."
    crumbs={[{ label: 'Télécharger' }]}
  />

  <section class="block">
    <div class="w">
      <div class="pl br" style="padding:24px;margin-top:8px">
        <p style="margin:0 0 10px"><StatusBadge status="developpement" label={RELEASE.plannedLabel} /></p>
        <h2 style="margin-top:0">Aucune release, aucun tag posé.</h2>
        <p>
          Il n'existe donc <strong>ni installeur, ni binaire, ni paquet distribuable</strong> à télécharger.
        </p>
        <p>
          La page <a href={RELEASE.releasesUrl} rel="noopener">Releases GitHub</a> restera vide tant que la
          <strong>{RELEASE.planned}</strong> n'aura pas été validée.
        </p>
        <div class="cta">
          <a class="bt" href={url('versions/')}>État des versions</a>
          <a class="bt" href={url('telecharger/installation/')}>Guide d'installation</a>
          <a class="bt" href={RELEASE.releasesUrl} rel="noopener">Releases GitHub ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>11.1</b> Ce qui est prévu</div>
      <h2>Ce qu'une version contiendra.</h2>
      <div class="ov">
        <table class="tb">
          <thead><tr><th>Élément</th><th>Forme attendue</th><th>État</th></tr></thead>
          <tbody>
            <tr><td>Launcher (bureau)</td><td>Application de bureau (Avalonia) pour piloter et observer</td><td><StatusBadge status="developpement" /></td></tr>
            <tr><td>Moteur SYNE</td><td>Binaire .NET et paquets du moteur</td><td><StatusBadge status="experimental" /></td></tr>
            <tr><td>ECHOS</td><td>Paquet Python (observation, API headless)</td><td><StatusBadge status="experimental" /></td></tr>
            <tr><td>PRISM</td><td>Projet Unreal (hors périmètre V0.2)</td><td><StatusBadge status="hors-perimetre" /></td></tr>
          </tbody>
        </table>
      </div>
      <div class="cc"><p>Ces lignes décrivent une <em>intention de forme</em>, pas un engagement de date : aucun jalon
        daté n'est fixé avant la consolidation des phases en cours.</p></div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>11.2</b> En attendant</div>
      <h2>Explorer le projet dès maintenant.</h2>
      <p>
        Le dépôt est public sous licence GNU GPL v3.0 ou ultérieure (hors projet Unreal PRISM) : vous pouvez lire le code, suivre l'avancement et faire tourner la pile
        depuis les sources. La documentation reste le meilleur point d'entrée.
      </p>
      <div class="cta">
        <a class="bt p" href={url('documentation/')}>Documentation</a>
        <a class="bt" href={url('telecharger/installation/')}>Installer depuis les sources</a>
        <a class="bt" href="https://github.com/donovan-dev-web/LIVEX" rel="noopener">Dépôt GitHub ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
