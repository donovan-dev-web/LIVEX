import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CtaBand from '../../components/CtaBand.astro';
import { RELEASE } from '../../data/release';
import { url } from '../../utils/url';
import { SITE } from '../../data/site';
---
<BaseLayout
  title="LIVEX — Télécharger : releases et installation"
  description="Télécharger LIVEX : release V1.0.0 disponible et V2.0.0 en préparation. État des versions, installation et dépôt GitHub."
>
  <PageHeader
    index="11"
    eyebrow="Télécharger"
    title="V1 publiée, V2 en préparation."
    lead="La release LIVEX 1.0.0 est disponible. La prochaine cible globale est V2.0.0, avec une refonte complète de PRISM."
    crumbs={[{ label: 'Télécharger' }]}
  />

  <section class="block">
    <div class="w">
      <div class="pl br" style="padding:24px;margin-top:8px">
        <p style="margin:0 0 10px"><StatusBadge status="developpement" label={RELEASE.plannedLabel} /></p>
        <h2 style="margin-top:0">La prochaine version prévue : {RELEASE.planned}.</h2>
        <p>La release V1.0.0 marque la première version publique. La cible V2.0.0 est en préparation ; cette page présente son périmètre prévu et ne revendique pas la validation de PRISM V2.</p>
        <p>Consultez la page <a href={RELEASE.releasesUrl} rel="noopener">Releases GitHub</a> pour les versions publiées.</p>
        <div class="cta">
          <a class="bt" href={url('versions/')}>État des versions</a>
          <a class="bt" href={url('telecharger/installation/')}>Guide d'installation</a>
          <a class="bt" href={RELEASE.releasesUrl} rel="noopener">Releases GitHub ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>11.1</b> Cible V2</div>
      <h2>Les composants prévus dans la V2.</h2>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Élément</th><th scope="col">Forme attendue</th><th scope="col">État</th></tr></thead>
          <tbody>
            <tr><td>Launcher (bureau)</td><td>Application de bureau (Avalonia) pour piloter et observer</td><td><StatusBadge status="developpement" /></td></tr>
            <tr><td>Moteur SYNE</td><td>Binaire .NET et paquets du moteur</td><td><StatusBadge status="experimental" /></td></tr>
            <tr><td>ECHOS</td><td>Paquet Python (observation, API headless)</td><td><StatusBadge status="experimental" /></td></tr>
            <tr><td>PRISM</td><td>Noyau .NET headless du monde physique, host et viewer Silk.NET facultatif</td><td><StatusBadge status="envisage" /></td></tr>
          </tbody>
        </table>
      </div>
      <div class="cc"><p>Ces lignes décrivent une <em>intention de forme</em>, pas un engagement de date : aucun jalon
        daté n'est fixé avant la consolidation des phases en cours.</p></div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>11.2</b> En attendant</div>
      <h2>Explorer le projet dès maintenant.</h2>
      <p>
        Le dépôt est public sous licence GNU GPL v3.0 ou ultérieure (hors projet Unreal PRISM) : vous pouvez lire le code, suivre l'avancement et faire tourner la pile
        depuis les sources. La documentation reste le meilleur point d'entrée.
      </p>
      <div class="cta">
        <a class="bt p" href={url('documentation/')}>Documentation</a>
        <a class="bt" href={url('telecharger/installation/')}>Installer depuis les sources</a>
        <a class="bt" href="https://github.com/donovan-dev-web/LIVEX" rel="noopener">Dépôt GitHub ↗</a>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="11.3 · Conversion"
    title="Explorer le projet dès maintenant"
    lead="Le dépôt est public : lecture du code, suivi de l'avancement, exécution depuis les sources."
    primaryLabel="Documentation"
    primaryHref="documentation/"
    secondaryLabel="Dépôt GitHub ↗"
    secondaryHref={SITE.repo}
  />
</BaseLayout>
