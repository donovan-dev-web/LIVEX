import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CtaBand from '../../components/CtaBand.astro';
import { RELEASE } from '../../data/release';
import { VERSIONS } from '../../data/versions';
import { url } from '../../utils/url';
import { SITE } from '../../data/site';
---
<BaseLayout
  title="LIVEX — Télécharger : releases et installation"
  description="Télécharger LIVEX 1.0.0 : installateurs Windows et Linux, variantes core et full."
>
  <PageHeader
    index="11"
    eyebrow="Télécharger"
    title="LIVEX 1.0.0 est disponible."
    lead="La première release publique comprend des installateurs Windows et Linux, en variantes core et full."
    crumbs={[{ label: 'Télécharger' }]}
  />

  <section class="block">
    <div class="w">
      <div class="pl br" style="padding:24px;margin-top:8px">
        <p style="margin:0 0 10px"><StatusBadge status="disponible" label={RELEASE.plannedLabel} /></p>
        <h2 style="margin-top:0">Installateurs disponibles</h2>
        <p>Choisissez votre plateforme et votre profil. La variante <code>core</code> télécharge les modules facultatifs au besoin ; <code>full</code> les embarque pour une installation hors ligne.</p>
        <div class="cta">
          <a class="bt p" href={RELEASE.releaseUrl} rel="noopener">Télécharger depuis GitHub ↗</a>
          <a class="bt" href={url('telecharger/installation/')}>Guide d'installation</a>
          <a class="bt" href={url(`versions/${VERSIONS[0].slug}/`)}>Notes de version</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>11.1</b> Contenu de LIVEX 1.0.0</div>
      <h2>Composants distribués.</h2>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Élément</th><th scope="col">Forme attendue</th><th scope="col">État</th></tr></thead>
          <tbody>
            <tr><td>Launcher</td><td>Application de bureau Avalonia</td><td><StatusBadge status="disponible" /></td></tr>
            <tr><td>SYNE</td><td>Moteur de simulation .NET</td><td><StatusBadge status="disponible" /></td></tr>
            <tr><td>ECHOS</td><td>Observation et analyse</td><td><StatusBadge status="disponible" /></td></tr>
            <tr><td>PRISM</td><td>Application packagée Windows/Linux</td><td><StatusBadge status="disponible" /></td></tr>
            <tr><td>PRISM-LDK</td><td>Plugin Unreal `PrismLdk` 1.0.0</td><td><StatusBadge status="disponible" /></td></tr>
          </tbody>
        </table>
      </div>
      <div class="cc"><p>Les versions, limites connues et empreintes de la release sont présentées dans les <a href={url(`versions/${VERSIONS[0].slug}/`)}>notes de version</a>.</p></div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>11.2</b> En attendant</div>
      <h2>Explorer le projet dès maintenant.</h2>
      <p>
        Le dépôt est public sous licence GNU GPL v3.0 ou ultérieure (hors projet Unreal PRISM) : vous pouvez lire le code, suivre l'avancement et faire tourner la pile
        depuis les sources. La documentation reste le meilleur point d'entrée.
      </p>
      <div class="cta">
        <a class="bt p" href={url('documentation/')}>Documentation</a>
        <a class="bt" href={url('telecharger/installation/')}>Guide d'installation</a>
        <a class="bt" href="https://github.com/donovan-dev-web/LIVEX" rel="noopener">Dépôt GitHub ↗</a>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="11.3 · Conversion"
    title="Explorer le projet dès maintenant"
    lead="Le dépôt est public : lecture du code, suivi de l'avancement, exécution depuis les sources."
    primaryLabel="Documentation"
    primaryHref="documentation/"
    secondaryLabel="Dépôt GitHub ↗"
    secondaryHref={SITE.repo}
  />
</BaseLayout>
