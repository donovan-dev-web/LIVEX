import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CtaBand from '../../components/CtaBand.astro';
import SyneSchema from '../../components/SyneSchema.astro';
import { Image } from 'astro:assets';
import echosAgents from '../../assets/captures/echos-agents.png';
import launcherPrism from '../../assets/captures/launcher-prism.png';
import { COMPONENTS } from '../../data/components';
import { url } from '../../utils/url';
---
<BaseLayout
  title="Architecture LIVEX : SYNE, ECHOS, PRISM"
  description="Architecture de LIVEX : moteur de simulation déterministe SYNE, observation ECHOS, rendu perceptif PRISM, reliés par des contrats d'interface versionnés."
>
  <PageHeader
    index="05"
    eyebrow="Architecture"
    title="Un pipeline, trois responsabilités."
    lead="LIVEX relie trois composants par des contrats explicites. Le monde produit des traces, l'observation les mesure, le rendu les donne à voir — sans jamais mélanger les rôles."
    crumbs={[{ label: 'Architecture' }]}
  />

  <div class="w" style="padding-top:8px">
    <TableOfContents />
  </div>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.1</b> Vue d'ensemble</div>
      <h2>Du monde à la perception.</h2>
      <div class="fm">
        monde <span>SYNE</span> traces <span>ECHOS</span> mesures <span>PRISM</span> perception
      </div>
      <p>
        Chaque étage est indépendant et versionné séparément : un composant peut être remplacé sans casser les autres,
        pourvu que les contrats de transport et de persistance soient respectés. C'est ce découplage qui rend la pile
        testable et évolutive.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.2</b> Les composants</div>
      <h2>Trois couches de runtime et leurs outils.</h2>
      {COMPONENTS.map((c) => (
        <div class="bn">
          <div>
            <span class="k">{c.acronym}</span>
            <h3>{c.name}</h3>
          </div>
          <div>
            <p>{c.summary}</p>
            <p style="margin:0 0 6px"><StatusBadge status={c.status.id} /></p>
            <p class="mu" style="margin:0 0 12px;font-size:0.76rem">{c.status.note}</p>
            <a class="bt" href={url(c.href)} aria-label={`Détails sur ${c.name}`}>Détails →</a>
          </div>
          {c.key === 'syne' && <SyneSchema lang="fr" />}
          {c.key === 'echos' && <Image src={echosAgents} alt="Capture d'ECHOS : suivi des agents observés" style="width:100%;height:auto" loading="lazy" />}
          {c.key === 'prism' && <Image src={launcherPrism} alt="Capture du rendu PRISM ouvert depuis le Launcher" style="width:100%;height:auto" loading="lazy" />}
        </div>
      ))}
      <p class="mu" style="font-size:0.7rem">Captures réelles de développement pour ECHOS et PRISM ; pour SYNE, un schéma conceptuel — un moteur n'a pas d'interface à capturer. Ces images illustrent des écrans du dépôt, mais ne constituent pas une capture du binaire installé de la release 1.0.0.</p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.3</b> Contrats d'interface</div>
      <h2>Ce qui relie les étages.</h2>
      <div class="ov">
        <table class="tb">
          <thead>
            <tr><th scope="col">Contrat</th><th scope="col">Version / forme</th><th scope="col">Note</th></tr>
          </thead>
          <tbody>
            <tr><td>Contrat d'observabilité (snapshot)</td><td>0.5.0</td><td>Ajout <code>simulatedTimeSeconds</code> ; description de monde <code>world_initialized</code> 1.1.</td></tr>
            <tr><td>Format d'identifiant de run</td><td><code>run-&lt;seed&gt;-&lt;12hex&gt;</code></td><td>La graine figure dans l'identifiant ; ECHOS ne la dérive pas de l'id.</td></tr>
            <tr><td>Schéma de persistance ECHOS</td><td>SQLite v6</td><td>Migration additive <code>mean_food</code>/<code>mean_water</code>.</td></tr>
            <tr><td>Ports locaux (configuration actuelle)</td><td>5180 / 5181 / 5000</td><td>Bindings <strong>locaux uniquement</strong> (<code>127.0.0.1</code>).</td></tr>
          </tbody>
        </table>
      </div>
      <div class="cc" style="margin-top:22px">
        <p>Ces contrats évoluent sous versionnement sémantique. Toute rupture est signalée dans le
          <a href="https://github.com/donovan-dev-web/LIVEX/blob/main/CHANGELOG.md" rel="noopener">CHANGELOG</a>.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.4</b> Organisation du dépôt</div>
      <h2>Un monorepo, des composants isolés.</h2>
      <div class="ov">
        <table class="tb">
          <thead>
            <tr><th scope="col">Répertoire</th><th scope="col">Contenu</th><th scope="col">État</th></tr>
          </thead>
          <tbody>
            <tr><td><code>syne/</code></td><td>Moteur de simulation .NET (SYNE)</td><td><StatusBadge status="experimental" /></td></tr>
            <tr><td><code>echos/</code></td><td>Observation, analyse, API headless (paquet Python)</td><td><StatusBadge status="experimental" /></td></tr>
            <tr><td><code>prism/</code></td><td>Projet Unreal packagé et plugin PRISM-LDK / PrismLdk</td><td><StatusBadge status="disponible" /></td></tr>
            <tr><td><code>installer/</code></td><td>Assistant de distribution, installation, maintenance et désinstallation Windows/Linux</td><td><StatusBadge status="disponible" /></td></tr>
            <tr><td><code>launcher/</code></td><td>Application de bureau (Avalonia) — orchestration et présentation</td><td><StatusBadge status="developpement" /></td></tr>
            <tr><td><code>docs/</code></td><td>Monographie, architecture, gouvernance, documentation</td><td>—</td></tr>
            <tr><td><code>site/</code></td><td>Ce site vitrine statique (Astro)</td><td>—</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.5</b> Pour aller plus loin</div>
      <h2>Orchestration et preuves.</h2>
      <div class="g2">
        <div class="pl br" style="padding:20px">
          <h3>Installateur LIVEX</h3>
          <p class="mu">Le composant de distribution qui installe les paquets publiés, gère leur maintenance et les désinstalle proprement.</p>
          <a class="bt" href={url('technique/installer/')}>L'installateur →</a>
        </div>
        <div class="pl br" style="padding:20px">
          <h3>Reproductibilité et mesures</h3>
          <p class="mu">Tests, couverture et benchmarks : ce qui est affirmé est mesuré, daté et reproductible — ou signalé comme non vérifié.</p>
          <a class="bt" href={url('technique/resultats/')}>Voir les résultats →</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="5.6 · Conversion"
    title="Vérifier et contribuer"
    lead="La documentation, le dépôt et la feuille de route prolongent l'architecture."
    primaryLabel="Documentation"
    primaryHref="documentation/"
    secondaryLabel="Feuille de route"
    secondaryHref="feuille-de-route/"
  />
</BaseLayout>
