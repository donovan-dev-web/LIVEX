import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CtaBand from '../../components/CtaBand.astro';
import SyneSchema from '../../components/SyneSchema.astro';
import { Image } from 'astro:assets';
import echosAgents from '../../assets/captures/echos-agents.png';
import { COMPONENTS } from '../../data/components';
import { url } from '../../utils/url';
---
<BaseLayout
  title="Architecture LIVEX : SYNE, ECHOS, PRISM"
  description="Architecture cible V2 de LIVEX : cognition SYNE, monde physique autoritaire PRISM et analyse ECHOS, reliés par des contrats versionnés."
>
  <PageHeader
    index="05"
    eyebrow="Architecture"
    title="Trois composants, des responsabilités séparées."
    lead="Dans la cible V2, SYNE porte la cognition, PRISM le monde physique et ECHOS l'observation. Le visualiseur PRISM lit le monde sans gouverner la simulation."
    crumbs={[{ label: 'Architecture' }]}
  />

  <div class="w" style="padding-top:8px">
    <TableOfContents />
  </div>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.1</b> Vue d'ensemble</div>
      <h2>De l’intention au monde observable.</h2>
      <div class="fm">
        cognition <span>SYNE</span> monde physique <span>PRISM</span> analyse <span>ECHOS</span>
      </div>
      <p>
        Cette architecture décrit le périmètre prévu de la V2. SYNE et PRISM échangent commandes, observations et
        événements ; ECHOS reçoit leurs traces et PRISM publie un flux de lecture. Le visualiseur est facultatif.
        Les informations de réalisation et de validation seront révisées avant publication.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.2</b> Les composants</div>
      <h2>Les composants et leur rôle prévu.</h2>
      {COMPONENTS.map((c) => (
        <div class="bn">
          <div>
            <span class="k">{c.acronym}</span>
            <h3>{c.name}</h3>
          </div>
          <div>
            <p>{c.summary}</p>
            <p style="margin:0 0 6px"><StatusBadge status={c.status.id} /></p>
            <p class="mu" style="margin:0 0 12px;font-size:0.76rem">{c.status.note}</p>
            <a class="bt" href={url(c.href)} aria-label={`Détails sur ${c.name}`}>Détails →</a>
          </div>
          {c.key === 'syne' && <SyneSchema lang="fr" />}
          {c.key === 'echos' && <Image src={echosAgents} alt="Capture d'ECHOS : suivi des agents observés" style="width:100%;height:auto" loading="lazy" />}
          {c.key === 'prism' && <p class="mu">La capture associée à PRISM présente la génération V1 ; elle n’illustre pas le visualiseur V2 prévu.</p>}
        </div>
      ))}
      <p class="mu" style="font-size:0.7rem">Le schéma SYNE est conceptuel. La capture ECHOS et l’ancienne capture PRISM illustrent des versions V1/de développement ; elles ne démontrent pas la réalisation de la cible V2.</p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.3</b> Contrats d'interface</div>
      <h2>Contrat et flux prévus.</h2>
      <div class="ov">
        <table class="tb">
          <thead>
            <tr><th scope="col">Contrat</th><th scope="col">Version / forme</th><th scope="col">Note</th></tr>
          </thead>
          <tbody>
            <tr><td>Contrat SYNE↔PRISM (cible V2)</td><td>1.0.0</td><td>Commandes, observations, événements et lecture du monde ; cible décrite dans les spécifications PRISM.</td></tr>
            <tr><td>Format d'identifiant de run</td><td><code>run-&lt;seed&gt;-&lt;12hex&gt;</code></td><td>La graine figure dans l'identifiant ; ECHOS ne la dérive pas de l'id.</td></tr>
            <tr><td>Schéma de persistance ECHOS</td><td>SQLite v6</td><td>Migration additive <code>mean_food</code>/<code>mean_water</code>.</td></tr>
            <tr><td>Flux de lecture PRISM</td><td>Cible V2</td><td>Deltas régionaux et état du monde pour ECHOS et le visualiseur facultatif.</td></tr>
          </tbody>
        </table>
      </div>
      <div class="cc" style="margin-top:22px">
        <p>Ces contrats évoluent sous versionnement sémantique. Toute rupture est signalée dans le
          <a href="https://github.com/donovan-dev-web/LIVEX/blob/main/CHANGELOG.md" rel="noopener">CHANGELOG</a>.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.4</b> Organisation du dépôt</div>
      <h2>Un monorepo, des composants isolés.</h2>
      <div class="ov">
        <table class="tb">
          <thead>
            <tr><th scope="col">Répertoire</th><th scope="col">Contenu</th><th scope="col">État</th></tr>
          </thead>
          <tbody>
            <tr><td><code>syne/</code></td><td>Cognition et décisions des agents</td><td>Cible V2</td></tr>
            <tr><td><code>echos/</code></td><td>Observation, analyse, API headless (paquet Python)</td><td><StatusBadge status="experimental" /></td></tr>
            <tr><td><code>prism/</code></td><td>Monde physique .NET headless ; viewer Silk.NET facultatif</td><td>Cible V2</td></tr>
            <tr><td><code>launcher/</code></td><td>Application de bureau (Avalonia) — orchestration et présentation</td><td><StatusBadge status="developpement" /></td></tr>
            <tr><td><code>docs/</code></td><td>Monographie, architecture, gouvernance, documentation</td><td>—</td></tr>
            <tr><td><code>site/</code></td><td>Ce site vitrine statique (Astro)</td><td>—</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.5</b> Pour aller plus loin</div>
      <h2>Orchestration et preuves.</h2>
      <div class="g2">
        <div class="pl br" style="padding:20px">
          <h3>Launcher</h3>
          <p class="mu">La couche d'orchestration : piloter, combiner et archiver les travaux conduits avec SYNE, ECHOS et PRISM depuis une interface unique.</p>
          <a class="bt" href={url('technique/launcher/')}>Le Launcher →</a>
        </div>
        <div class="pl br" style="padding:20px">
          <h3>Reproductibilité et mesures</h3>
          <p class="mu">Tests, couverture et benchmarks : ce qui est affirmé est mesuré, daté et reproductible — ou signalé comme non vérifié.</p>
          <a class="bt" href={url('technique/resultats/')}>Voir les résultats →</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="5.6 · Conversion"
    title="Vérifier et contribuer"
    lead="La documentation, le dépôt et la feuille de route prolongent l'architecture."
    primaryLabel="Documentation"
    primaryHref="documentation/"
    secondaryLabel="Feuille de route"
    secondaryHref="feuille-de-route/"
  />
</BaseLayout>
