import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CtaBand from '../../components/CtaBand.astro';
import SyneSchema from '../../components/SyneSchema.astro';
import { Image } from 'astro:assets';
import echosAgents from '../../assets/captures/echos-agents.png';
import prismViewer from '../../assets/captures/prism-viewer-embedded.png';
import { COMPONENTS } from '../../data/components';
import { url } from '../../utils/url';
---
<BaseLayout
  title="Architecture LIVEX : SYNE, ECHOS, PRISM"
  description="Architecture V2 de LIVEX : cognition SYNE, monde physique autoritaire PRISM et analyse ECHOS, reliés par des contrats versionnés et un socle livré."
>
  <PageHeader
    index="05"
    eyebrow="Architecture"
    title="Trois composants, des responsabilités séparées."
    lead="Dans l'architecture V2, SYNE porte la cognition, PRISM le monde physique et ECHOS l'observation. Le visualiseur PRISM lit le monde sans gouverner la simulation."
    crumbs={[{ label: 'Architecture' }]}
  />

  <div class="w" style="padding-top:8px">
    <TableOfContents />
  </div>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.1</b> Vue d'ensemble</div>
      <h2>De l’intention au monde observable.</h2>
      <div class="fm">
        cognition <span>SYNE</span> monde physique <span>PRISM</span> analyse <span>ECHOS</span>
      </div>
      <p>
        Cette architecture est désormais celle du dépôt : le socle V2 est livré et testé (P0–P11 au 15 novembre 2026),
        SYNE et PRISM échangent commandes, observations et événements, ECHOS reçoit leurs traces et PRISM publie un flux
        de lecture. Le visualiseur est facultatif et ne fait jamais avancer la simulation. Aucune release V2 n'est publiée ;
        les preuves manquantes (B8, validation Linux, G1) restent nommées.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.2</b> Les composants</div>
      <h2>Les composants et leur rôle.</h2>
      {COMPONENTS.map((c) => (
        <div class="bn">
          <div>
            <span class="k">{c.acronym}</span>
            <h3>{c.name}</h3>
          </div>
          <div>
            <p>{c.summary}</p>
            <p style="margin:0 0 6px"><StatusBadge status={c.status.id} /></p>
            <p class="mu" style="margin:0 0 12px;font-size:0.76rem">{c.status.note}</p>
            <a class="bt" href={url(c.href)} aria-label={`Détails sur ${c.name}`}>Détails →</a>
          </div>
          {c.key === 'syne' && <SyneSchema lang="fr" />}
          {c.key === 'echos' && <Image src={echosAgents} alt="Capture d'ECHOS : suivi des agents observés" style="width:100%;height:auto" loading="lazy" />}
          {c.key === 'prism' && <Image src={prismViewer} alt="Viewer PRISM V2 en mode embarqué : monde 256×256, agents et HUD de débogage" style="width:100%;height:auto" loading="lazy" />}
        </div>
      ))}
      <p class="mu" style="font-size:0.7rem">Le schéma SYNE est conceptuel. La capture ECHOS illustre une version V1 de travail ; la capture PRISM montre le viewer V2 en mode embarqué, prise le 15 novembre 2026 par le module <code>--screenshot</code> (monde 256×256, huit agents). Elle documente le rendu, pas le relevé B8 ni la validation graphique Linux.</p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.3</b> Contrats d'interface</div>
      <h2>Contrats et flux en service.</h2>
      <div class="ov">
        <table class="tb">
          <thead>
            <tr><th scope="col">Contrat</th><th scope="col">Version / forme</th><th scope="col">Note</th></tr>
          </thead>
          <tbody>
            <tr><td>Contrat SYNE↔PRISM</td><td>1.0.0 (gelé le 04/11/2026)</td><td>Commandes, observations, événements et lecture du monde ; 21 kinds de commande couverts par une matrice de conformité.</td></tr>
            <tr><td>Contrat d'observabilité SYNE</td><td>0.6.0</td><td>Traces, snapshots et événements consommés par ECHOS ; version du moteur 0.18.0.</td></tr>
            <tr><td>Format d'identifiant de run</td><td><code>run-&lt;seed&gt;-&lt;12hex&gt;</code></td><td>La graine figure dans l'identifiant ; ECHOS ne la dérive pas de l'id.</td></tr>
            <tr><td>Schéma de persistance ECHOS</td><td>SQLite v9</td><td>Migrations additives, dont l'ingestion du flux PRISM (<code>POST /ingest/prism</code>).</td></tr>
            <tr><td>Flux de lecture PRISM</td><td>Livré — WebSocket <code>/data/read</code></td><td>Instantanés, deltas régionaux et état du monde pour ECHOS et le visualiseur facultatif ; port défini par la configuration de l'hôte.</td></tr>
          </tbody>
        </table>
      </div>
      <div class="cc" style="margin-top:22px">
        <p>Ces contrats évoluent sous versionnement sémantique. Toute rupture est signalée dans le
          <a href="https://github.com/donovan-dev-web/LIVEX/blob/main/CHANGELOG.md" rel="noopener">CHANGELOG</a>.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.4</b> Organisation du dépôt</div>
      <h2>Un monorepo, des composants isolés.</h2>
      <div class="ov">
        <table class="tb">
          <thead>
            <tr><th scope="col">Répertoire</th><th scope="col">Contenu</th><th scope="col">État</th></tr>
          </thead>
          <tbody>
            <tr><td><code>syne/</code></td><td>Cognition et décisions des agents (0.18.0)</td><td>Livré (dépôt)</td></tr>
            <tr><td><code>echos/</code></td><td>Observation, analyse, API headless (paquet Python 0.1.0)</td><td><StatusBadge status="experimental" /></td></tr>
            <tr><td><code>prism/</code></td><td>Monde physique .NET headless ; viewer Silk.NET facultatif</td><td>P0–P11 livré</td></tr>
            <tr><td><code>launcher/</code></td><td>Application de bureau (Avalonia) — orchestration et présentation</td><td>0.1.0 livré</td></tr>
            <tr><td><code>docs/</code></td><td>Monographie, architecture, gouvernance, documentation</td><td>—</td></tr>
            <tr><td><code>site/</code></td><td>Ce site vitrine statique (Astro)</td><td>—</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.5</b> Pour aller plus loin</div>
      <h2>Orchestration et preuves.</h2>
      <div class="g2">
        <div class="pl br" style="padding:20px">
          <h3>Launcher</h3>
          <p class="mu">La couche d'orchestration : piloter, combiner et archiver les travaux conduits avec SYNE, ECHOS et PRISM depuis une interface unique.</p>
          <a class="bt" href={url('technique/launcher/')}>Le Launcher →</a>
        </div>
        <div class="pl br" style="padding:20px">
          <h3>Reproductibilité et mesures</h3>
          <p class="mu">Tests, couverture et benchmarks : ce qui est affirmé est mesuré, daté et reproductible — ou signalé comme non vérifié.</p>
          <a class="bt" href={url('technique/resultats/')}>Voir les résultats →</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="5.6 · Conversion"
    title="Vérifier et contribuer"
    lead="La documentation, le dépôt et la feuille de route prolongent l'architecture."
    primaryLabel="Documentation"
    primaryHref="documentation/"
    secondaryLabel="Feuille de route"
    secondaryHref="feuille-de-route/"
  />
</BaseLayout>
