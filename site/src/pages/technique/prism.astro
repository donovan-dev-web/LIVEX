import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CtaBand from '../../components/CtaBand.astro';
import { Image } from 'astro:assets';
import { url } from '../../utils/url';
import prismShot from '../../assets/captures/launcher-prism.png';
---
<BaseLayout
  title="PRISM : rendu perceptif (hors V0.2)"
  description="PRISM rend perceptible le monde simulé LIVEX : projet Unreal et plugin PRISM-LDK. Composant en développement, hors périmètre de la version V0.2."
>
  <PageHeader
    index="08"
    eyebrow="Architecture · PRISM"
    title="Le rendu."
    lead="PRISM (Perceptual Rendering & Interactive Simulation Module) donne forme et présence au monde simulé. C'est le composant le moins avancé du projet, et nous le disons."
    crumbs={[{ label: 'Architecture', href: 'technique/' }, { label: 'PRISM' }]}
  />

  <div class="w" style="padding-top:8px">
    <TableOfContents />
  </div>

  <section class="block">
    <div class="w">
      <p style="margin-top:0"><StatusBadge status="developpement" /> <span class="mu">Projet Unreal et plugin PRISM-LDK</span></p>
      <div class="cc"><p><strong>PRISM-LDK</strong> (LIVEX Development Kit) est le cœur de la représentation 3D : le plugin Unreal qui traduit les données logiques de SYNE en représentation graphique 3D, <strong>réalisé et packagé en version 0.1.0</strong>. <strong>PRISM</strong> est le projet Unreal construit autour de ce plugin : la représentation stylisée par défaut, selon la vision de l'auteur. PRISM reste <strong>hors périmètre V0.2</strong> : aucune expérience de rendu jouable n'est revendiquée à ce jour.</p></div>

      <div class="sh"><b>8.1</b> Rôle</div>
      <h2>Donner à voir la dynamique.</h2>
      <p>
        Là où SYNE calcule et ECHOS mesure, PRISM <strong>rend perceptible</strong> : il transforme l'état du monde et
        ses événements en une scène observable et interactive. Il se compose d'un projet Unreal et d'un plugin
        d'intégration, <strong>PRISM-LDK</strong>.
      </p>

      <figure class="shot">
        <Image src={prismShot} alt="Aperçu du rendu PRISM"  loading="lazy" />
        <figcaption>Capture — aperçu du rendu PRISM (version de travail).</figcaption>
      </figure>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>8.2</b> État</div>
      <h2>Le composant le plus jeune.</h2>
      <p>
        PRISM est en version de travail. Aucune promesse n'est faite sur son échéance : le rendu est volontairement
        hors périmètre V0.2, pour ne pas diluer la validation du moteur et de l'observation.
      </p>
      <p class="mu" style="font-size:0.82rem">
        La feuille de route du projet fait foi pour les étapes à venir.
      </p>
      <div class="cc">
        <p>Ne présumez pas que les protections locales du moteur ou du mock sécurisent une distribution du projet
          PRISM. Voir <a href="https://github.com/donovan-dev-web/LIVEX/blob/main/SECURITY.md" rel="noopener">SECURITY.md</a>.</p>
      </div>
      <p style="margin-top:18px"><a class="bt" href={url('technique/')}>← Vue d'ensemble</a></p>
    </div>
  </section>

  <CtaBand
    eyebrow="8.3 · Conversion"
    title="Aller plus loin"
    lead="Le moteur, l'observation et la documentation prolongent le rendu."
    primaryLabel="SYNE : moteur"
    primaryHref="technique/syne/"
    secondaryLabel="Documentation"
    secondaryHref="documentation/"
  />
</BaseLayout>
