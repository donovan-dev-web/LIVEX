import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { url } from '../../utils/url';
---
<BaseLayout
  title="SYNE : moteur de simulation déterministe"
  description="SYNE, moteur de simulation multi-agents déterministe de LIVEX : monde, agents, règles explicites et rejouabilité bit-à-bit à partir d'une graine."
>
  <PageHeader
    index="06"
    eyebrow="Architecture · SYNE"
    title="Le moteur."
    lead="SYNE (Systems & Emergent Network Engine) fait tourner le monde simulé. Il est déterministe : à partir de la même graine, un run se rejoue à l'identique."
    crumbs={[{ label: 'Architecture', href: 'technique/' }, { label: 'SYNE' }]}
  />

  <section class="block">
    <div class="w">
      <p style="margin-top:0"><StatusBadge status="experimental" /> <span class="mu">SYNE 0.17.0 · moteur .NET (dépôt)</span></p>
      <div class="cc"><p>Expérimental : le moteur est fonctionnel dans le dépôt, mais aucune distribution publique n'existe à ce jour.</p></div>

      <div class="sh"><b>6.1</b> Rôle</div>
      <h2>Poser des règles, laisser faire.</h2>
      <p>
        SYNE définit un <strong>monde</strong> (espace, ressources, temps) et des <strong>agents</strong> qui agissent
        selon des règles explicites. À chaque tick, le monde avance d'un pas déterministe : aucune décision n'est
        laissée au hasard non enregistré.
      </p>
      <p>
        L'intérêt pour le chercheur : les règles sont lisibles, versionnées et rejouables. Un résultat peut être relu,
        discuté et reproduit par un tiers, sans dépendre d'un moteur opaque.
      </p>
      <p>
        Le moteur produit un <strong>snapshot</strong> — une photographie structurée de l'état du monde — et une trace
        d'événements. C'est cette trace, et non le moteur, que consomme l'observation.
      </p>

      <div class="pl br" style="margin-top:20px">
        <div class="ph">Capture SYNE<br />à fournir · 16:9</div>
        <small><b>Fig. 1</b> — Emplacement de capture réservé : aucune capture réelle de SYNE n'est disponible à ce jour. Un visuel n'est publié qu'une fois authentique.</small>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>6.2</b> Déterminisme</div>
      <h2>Le même départ, le même run.</h2>
      <p>
        Le déterminisme <strong>bit-à-bit</strong> est un contrat : rejouer un run avec la même graine doit reproduire
        exactement la même trajectoire. C'est ce qui rend un résultat vérifiable et une mesure reproductible.
      </p>
      <div class="ov">
        <table class="tb">
          <thead><tr><th>Élément</th><th>Valeur</th></tr></thead>
          <tbody>
            <tr><td>Version du moteur</td><td>0.17.0</td></tr>
            <tr><td>Identifiant de run</td><td><code>run-&lt;seed&gt;-&lt;12hex&gt;</code></td></tr>
            <tr><td>Contrat de snapshot</td><td>0.5.0</td></tr>
            <tr><td>Schéma de persistance</td><td>v5</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>6.3</b> Suite</div>
      <p style="margin-top:0">
        <a class="bt" href={url('technique/echos/')}>ECHOS : observation →</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={url('technique/')}>Vue d'ensemble</a>
      </p>
    </div>
  </section>
</BaseLayout>
