---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url, absoluteUrl } from '../../utils/url';

export async function getStaticPaths() {
  const entries = await getCollection('actualites', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  alternates={{ en: 'actualites/' }}
>
  <PageHeader
    index="17"
    eyebrow="Journal"
    title={entry.data.title}
    lead={entry.data.description}
    crumbs={[{ label: 'Journal', href: 'actualites/' }, { label: entry.data.title }]}
  />

  <section class="block">
    <div class="w">
      <p class="mu" style="font-size:0.78rem">
        <time datetime={entry.data.date.toISOString()}>{fmt.format(entry.data.date)}</time>
        {entry.data.tags.length > 0 && <> · {entry.data.tags.join(' · ')}</>}
      </p>
      <Content />
      <p style="margin-top:24px">
        <a class="bt" href={url('actualites/')}>Toutes les actualités</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={absoluteUrl('actualites/feed.xml')}>Flux RSS</a>
      </p>
    </div>
  </section>
</BaseLayout>
