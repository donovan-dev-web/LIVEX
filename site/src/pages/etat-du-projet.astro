import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { PROJECT_STATE, RELEASE } from '../data/release';
import { url } from '../utils/url';

const nf = new Intl.NumberFormat('fr-FR');
const repo = 'https://github.com/donovan-dev-web/LIVEX/blob/main';
---
<BaseLayout
  title="LIVEX — État du projet : tests, couverture et CI"
  description="État factuel et daté du dépôt LIVEX : branche, commit, fichiers, lignes de code, tests, couverture, CI et support Windows."
>
  <PageHeader
    index="13b"
    eyebrow="Versions"
    title="L'état du projet, daté."
    lead="Un relevé factuel de la release et du dépôt associé, composant par composant : tests, couverture, versions et fichiers mesurés."
    crumbs={[{ label: 'Versions', href: 'versions/' }, { label: 'État du projet' }]}
  />

  <section class="block">
    <div class="w">
      <div class="cc"><p><strong>LIVEX {RELEASE.latest} est publiée.</strong> Les installateurs Windows/Linux sont disponibles dans
        <a href={RELEASE.releaseUrl} rel="noopener">la release GitHub</a> et
        <a href={`${repo}/docs/governance/LIVEX-STATUS.md`} rel="noopener">LIVEX-STATUS.md</a>.</p></div>

      <div class="sh"><b>13b.1</b> Référence analysée</div>
      <h2>Mesuré le {PROJECT_STATE.observedDate}.</h2>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Indicateur</th><th scope="col">Valeur</th></tr></thead>
          <tbody>
            <tr><td>Référence</td><td><code>{PROJECT_STATE.branch}</code> à {PROJECT_STATE.commit}</td></tr>
            <tr><td>Fichiers analysés par Tokei</td><td>{nf.format(PROJECT_STATE.filesScanned)}</td></tr>
            <tr><td>LOC Tokei</td><td>{nf.format(PROJECT_STATE.loc.total)} lignes de code</td></tr>
            <tr><td>Tests validés pour la release</td><td>{PROJECT_STATE.tests.documentedTotal} cas : {PROJECT_STATE.tests.passed} réussis, {PROJECT_STATE.tests.ignored} ignorés, {PROJECT_STATE.tests.failed} échec</td></tr>
            <tr><td>PRISM / PRISM-LDK</td><td>{PROJECT_STATE.tests.prismSpecs} specs : 71 réussies, 5 réussies avec avertissements</td></tr>
            <tr><td>Installateur</td><td>{PROJECT_STATE.tests.installerCases} tests exécutés et réussis</td></tr>
            <tr><td>Couverture ECHOS</td><td>{PROJECT_STATE.coverage.echos}</td></tr>
            <tr><td>Couverture SYNE</td><td>{PROJECT_STATE.coverage.syne} (Core {PROJECT_STATE.coverage.syneCore}, Console {PROJECT_STATE.coverage.syneConsole})</td></tr>
            <tr><td>CI</td><td>{PROJECT_STATE.ci}</td></tr>
            <tr><td>Windows</td><td>{PROJECT_STATE.windows}</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top:18px">
        <a class="bt" href={url('versions/')}>Voir les versions par composant →</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={`${repo}/docs/governance/LIVEX-STATUS.md`} rel="noopener">LIVEX-STATUS.md →</a>
      </p>
    </div>
  </section>
</BaseLayout>
