import BaseLayout from '../layouts/BaseLayout.astro';
import { url, absoluteUrl } from '../utils/url';

const baseUrl = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Page introuvable (404) · Page not found"
  description="La page demandée n'existe pas ou a été déplacée. · The requested page does not exist or has moved. Retrouvez le contenu via le plan du site."
  noindex={true}
  canonical={absoluteUrl('404.html')}
  alternates={{ fr: '', en: '' }}
>
  <div class="w">
    <h1 class="sr-only">Page introuvable (404) · Page not found</h1>
    <section class="hero" style="grid-template-columns:1fr;padding-top:64px">
      <div data-404="fr" hidden>
        <p class="ey">Erreur 404</p>
        <p class="hero-title">Hors du monde<br /><i>connu.</i></p>
        <p class="l">
          Cette page n'existe pas, ou n'existe plus. Le monde simulé continue, lui — mais pas ici. Le plan du site
          recense toutes les pages encore en ligne.
        </p>
        <div class="cta">
          <a class="bt p" href={url('')}>Retour à l'accueil</a>
          <a class="bt" href={url('documentation/')}>Documentation</a>
          <a class="bt" href={url('actualites/')}>Journal</a>
          <a class="bt" href={url('plan-du-site/')}>Plan du site</a>
          <a class="bt" href={url('', 'en')} hreflang="en" lang="en">English →</a>
        </div>
      </div>

      <div data-404="en" hidden>
        <p class="ey">Error 404</p>
        <p class="hero-title">Beyond the<br /><i>known world.</i></p>
        <p class="l">
          This page does not exist, or no longer does. The simulated world goes on — just not here. The sitemap lists
          every page still online.
        </p>
        <div class="cta">
          <a class="bt p" href={url('', 'en')}>Back to home</a>
          <a class="bt" href={url('documentation/', 'en')}>Documentation</a>
          <a class="bt" href={url('actualites/', 'en')}>Journal</a>
          <a class="bt" href={url('plan-du-site/', 'en')}>Sitemap</a>
          <a class="bt" href={url('', 'fr')} hreflang="fr" lang="fr">Français →</a>
        </div>
      </div>
    </section>

    <section class="block" style="padding-top:0">
      <div data-404="fr" hidden>
        <div class="sh"><b>—</b> Pistes</div>
        <h2>Où aller ensuite ?</h2>
        <p class="lead">Quelques points d'entrée pour retrouver votre chemin.</p>
        <ul class="cta" style="list-style:none;padding:0">
          <li><a class="bt" href={url('')}>Accueil</a></li>
          <li><a class="bt" href={url('documentation/')}>Documentation</a></li>
          <li><a class="bt" href={url('technique/')}>Architecture</a></li>
          <li><a class="bt" href={url('comprendre/')}>Comprendre</a></li>
          <li><a class="bt" href={url('plan-du-site/')}>Plan du site</a></li>
          <li><a class="bt" href={url('faq/')}>FAQ</a></li>
        </ul>
        <p style="margin-top:18px;font-size:0.82rem;color:var(--mu)">
          Astuce : <kbd>Ctrl</kbd>+<kbd>K</kbd> (ou <kbd>⌘</kbd>+<kbd>K</kbd>) ouvre la recherche sur le site.
        </p>
      </div>
      <div data-404="en" hidden>
        <div class="sh"><b>—</b> Leads</div>
        <h2>Where to next?</h2>
        <p class="lead">A few entry points to find your way back.</p>
        <ul class="cta" style="list-style:none;padding:0">
          <li><a class="bt" href={url('', 'en')}>Home</a></li>
          <li><a class="bt" href={url('documentation/', 'en')}>Documentation</a></li>
          <li><a class="bt" href={url('technique/', 'en')}>Architecture</a></li>
          <li><a class="bt" href={url('comprendre/', 'en')}>Understand</a></li>
          <li><a class="bt" href={url('plan-du-site/', 'en')}>Sitemap</a></li>
          <li><a class="bt" href={url('faq/', 'en')}>FAQ</a></li>
        </ul>
        <p style="margin-top:18px;font-size:0.82rem;color:var(--mu)">
          Tip: <kbd>Ctrl</kbd>+<kbd>K</kbd> (or <kbd>⌘</kbd>+<kbd>K</kbd>) opens site search.
        </p>
      </div>
    </section>
  </div>

  <noscript>
    <style>[data-404] { display: block !important; }</style>
    <div class="w">
      <p>
        <a href={url('')}>Accueil (FR)</a> · <a href={url('', 'en')}>Home (EN)</a>
      </p>
    </div>
  </noscript>

  <script is:inline define:vars={{ baseUrl }}>
    (function () {
      var base = baseUrl;
      var path = location.pathname;
      if (path.indexOf(base) === 0) path = path.slice(base.length);
      var lang = path.split('/').filter(Boolean)[0] === 'en' ? 'en' : 'fr';
      document.documentElement.setAttribute('lang', lang);
      var blocks = document.querySelectorAll('[data-404]');
      for (var i = 0; i < blocks.length; i++) {
        if (blocks[i].getAttribute('data-404') === lang) blocks[i].removeAttribute('hidden');
      }
    })();
  </script>
</BaseLayout>
