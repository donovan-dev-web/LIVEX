import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE } from '../../data/site';
import { PROJECT_STATE_EN, RELEASE } from '../../data/release';
import { url } from '../../utils/url';

const logoUrl = `${SITE.repo}/blob/main/site/src/assets/marks/livex-mark.svg`;
---
<BaseLayout
  lang="en"
  translated
  title="Press kit — resources for journalists"
  description="LIVEX press kit: 15-, 30- and 60-second boilerplate, dated key facts, logo, component marks and usage rules for journalists and creators."
>
  <PageHeader
    lang="en"
    index="27"
    eyebrow="Press kit"
    title="Resources for the press."
    lead="Everything you need to talk about LIVEX without distorting it: ready-to-use boilerplate, verifiable facts and visual usage rules."
    crumbs={[{ label: 'Press kit' }]}
  />

  <section class="block">
    <div class="w">
      <div class="sh"><b>27.1</b> In one sentence</div>
      <h2>The project, summarised.</h2>
      <blockquote class="sf" style="font-size:clamp(1.5rem,3vw,2.2rem);line-height:1.3;margin:0 0 20px;border-left:2px solid var(--ve);padding-left:22px;max-width:42ch">
        LIVEX is a multi-agent simulation ecosystem that makes collective behaviour observable: an engine
        (SYNE), a cognition-observation system (ECHOS) and a perceptual renderer (PRISM).
      </blockquote>

      <div class="g3 br">
        <div>
          <h3>15 seconds</h3>
          <p>{SITE.name} simulates worlds inhabited by autonomous entities. It does not program behaviour: it builds
            the laws that let behaviour emerge, then measures it.</p>
        </div>
        <div>
          <h3>30 seconds</h3>
          <p>{SITE.name} brings together a simulation engine (SYNE), a cognition-observation system (ECHOS) and a
            perceptual renderer (PRISM). The goal: produce behaviour that was not explicitly programmed, then analyse
            and reproduce it.</p>
        </div>
        <div>
          <h3>1 minute</h3>
          <p>Born of one question — can emergent behaviour arise from simple laws? — {SITE.name} is a personal
            research project. LIVEX component code is open under the GNU GPL v3.0 or later; the Unreal PRISM project remains subject to the Epic Games EULA. No public release exists yet; the state of the
            repository is published and dated.</p>
        </div>
      </div>
      <p class="mu" style="margin-top:16px;font-size:0.78rem">
        These three levels of detail may be reused as they are, provided the project and its author are credited —
        see <a href={url('licence/', 'en')}>licence and reuse</a>.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>27.2</b> Key facts</div>
      <h2>Facts, not slogans.</h2>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Item</th><th scope="col">Value</th></tr></thead>
          <tbody>
            <tr><td>Name</td><td>LIVEX — Living Intelligent Virtual Ecosystem eXperience</td></tr>
            <tr><td>Nature</td><td>Personal research project in multi-agent simulation</td></tr>
            <tr><td>Components</td><td>SYNE (engine) · ECHOS (observation) · PRISM (rendering)</td></tr>
            <tr><td>Author</td><td>Donovan Chartrain</td></tr>
            <tr><td>Licence</td><td>GPL-3.0-or-later (LIVEX code excluding PRISM) · CC BY 4.0 (site content)</td></tr>
            <tr><td>Release</td><td>No public release — target version {RELEASE.planned}</td></tr>
            <tr><td>Last measured state</td><td>{PROJECT_STATE_EN.observedDate}</td></tr>
            <tr><td>Repository</td><td><a href={SITE.repo} rel="noopener">github.com/donovan-dev-web/LIVEX ↗</a></td></tr>
          </tbody>
        </table>
      </div>
      <p class="mu" style="margin-top:14px;font-size:0.76rem">
        Figures and project state come from <a href={url('versions/', 'en')}>the Versions page</a>; they are dated and
        do not amount to a stability promise.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>27.3</b> Logo and visual identity</div>
      <h2>The mark, and its limits.</h2>
      <p>
        The LIVEX logo is a vector file available in the repository:
        <a href={logoUrl} rel="noopener">livex-mark.svg ↗</a>. Three component marks accompany the main one, in the
        same folder:
        <a href={`${SITE.repo}/blob/main/site/src/assets/marks/syne-mark.svg`} rel="noopener">syne-mark.svg ↗</a>,
        <a href={`${SITE.repo}/blob/main/site/src/assets/marks/echos-mark.svg`} rel="noopener">echos-mark.svg ↗</a>,
        <a href={`${SITE.repo}/blob/main/site/src/assets/marks/prism-mark.svg`} rel="noopener">prism-mark.svg ↗</a>.
      </p>
      <p class="mu" style="font-size:0.78rem">
        Real screenshots of the Launcher and ECHOS are also published in the repository
        (<a href={`${SITE.repo}/tree/main/site/public/captures`} rel="noopener">site/public/captures/ ↗</a>) and may be
        reused. The captures in that folder come from the development build: do not cite them as footage of a published version.
      </p>
      <div class="cc" style="padding:18px 20px">
        <p><strong>Usage rules.</strong> The LIVEX name and logo are protected; their use is reserved for editorial and
          descriptive purposes. Do not modify them, or imply affiliation or endorsement. Site content may be reused
          under <a href={url('licence/', 'en')}>CC BY 4.0</a>; LIVEX component code is under the GNU GPL v3.0 or later, while the Unreal PRISM project remains under the Epic Games EULA.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>27.4</b> Contact</div>
      <h2>To go further.</h2>
      <p>
        Editorial requests, interviews or requests for additional visuals go through the public repository:
        <a href={`${SITE.repo}/issues`} rel="noopener">github.com/donovan-dev-web/LIVEX/issues ↗</a>.
      </p>
      <p style="margin-top:18px">
        <a class="bt" href={url('a-propos/', 'en')}>About the author</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={url('licence/', 'en')}>Licence and reuse</a>
      </p>
    </div>
  </section>
</BaseLayout>
