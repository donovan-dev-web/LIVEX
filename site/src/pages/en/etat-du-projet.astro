import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { PROJECT_STATE, PROJECT_STATE_EN, RELEASE } from '../../data/release';
import { url } from '../../utils/url';

const nf = new Intl.NumberFormat('en-US');
const repo = 'https://github.com/donovan-dev-web/LIVEX/blob/main';
---
<BaseLayout
  lang="en"
  translated
  title="LIVEX — Project state: tests, coverage and CI"
  description="Factual, dated state of the LIVEX repository: branch, commit, files, lines of code, tests, coverage, CI and Windows support."
>
  <PageHeader
    lang="en"
    index="13b"
    eyebrow="Versions"
    title="The project state, dated."
    lead="A factual snapshot of the release and its repository, component by component: tests, coverage, versions and measured files."
    crumbs={[{ label: 'Versions', href: 'versions/' }, { label: 'Project state' }]}
  />

  <section class="block">
    <div class="w">
      <div class="cc"><p><strong>LIVEX {RELEASE.latest} is released.</strong> Windows/Linux installers are available in
        <a href={RELEASE.releaseUrl} rel="noopener">the GitHub release</a> and
        <a href={`${repo}/docs/governance/LIVEX-STATUS.md`} rel="noopener">LIVEX-STATUS.md</a>.</p></div>

      <div class="sh"><b>13b.1</b> Analysed reference</div>
      <h2>Measured on {PROJECT_STATE_EN.observedDate}.</h2>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Indicator</th><th scope="col">Value</th></tr></thead>
          <tbody>
            <tr><td>Reference</td><td><code>{PROJECT_STATE.branch}</code> at {PROJECT_STATE.commit}</td></tr>
            <tr><td>Files analysed by Tokei</td><td>{nf.format(PROJECT_STATE.filesScanned)}</td></tr>
            <tr><td>Tokei LOC</td><td>{nf.format(PROJECT_STATE.loc.total)} lines of code</td></tr>
            <tr><td>Release tests</td><td>{PROJECT_STATE.tests.documentedTotal} cases: {PROJECT_STATE.tests.passed} passed, {PROJECT_STATE.tests.ignored} skipped, {PROJECT_STATE.tests.failed} failed</td></tr>
            <tr><td>PRISM / PRISM-LDK</td><td>{PROJECT_STATE.tests.prismSpecs} specs: 71 passed, 5 passed with warnings</td></tr>
            <tr><td>Installer</td><td>{PROJECT_STATE.tests.installerCases} tests executed and passed</td></tr>
            <tr><td>ECHOS coverage</td><td>{PROJECT_STATE_EN.coverage.echos}</td></tr>
            <tr><td>SYNE coverage</td><td>{PROJECT_STATE_EN.coverage.syne} (Core {PROJECT_STATE_EN.coverage.syneCore}, Console {PROJECT_STATE_EN.coverage.syneConsole})</td></tr>
            <tr><td>CI</td><td>{PROJECT_STATE_EN.ci}</td></tr>
            <tr><td>Windows</td><td>{PROJECT_STATE_EN.windows}</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top:18px">
        <a class="bt" href={url('versions/', 'en')}>See component versions →</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={`${repo}/docs/governance/LIVEX-STATUS.md`} rel="noopener">LIVEX-STATUS.md →</a>
      </p>
    </div>
  </section>
</BaseLayout>
