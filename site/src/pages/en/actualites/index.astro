import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { url } from '../../../utils/url';
---
<BaseLayout
  lang="en"
  translated
  title="Journal — LIVEX milestones in French"
  description="The LIVEX development journal: dated milestones, technical decisions and in-depth articles on multi-agent simulation, published in French with an RSS feed."
>
  <PageHeader
    lang="en"
    index="17"
    eyebrow="Journal"
    title="The record of the days."
    lead="Milestones and technical decisions, dated and sourced. In-depth articles are added progressively."
    crumbs={[{ label: 'Journal' }]}
  />

  <section class="block">
    <div class="w">
      <div class="cc" style="padding:18px 20px">
        <p>
          The journal is written and published <strong>in French only</strong>. Rather than offer a degraded machine
          translation of each article, this English mirror points to the original, which remains authoritative.
        </p>
      </div>
      <p class="mu" style="margin-top:18px;font-size:0.78rem">
        The RSS feed is also French. Both links below take you to the French version of the site.
      </p>
      <p style="margin-top:18px">
        <a class="bt p" href={url('actualites/', 'fr')}>Read the journal (French) →</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={url('suivre/', 'en')}>Follow the project</a>
      </p>
    </div>
  </section>
</BaseLayout>
