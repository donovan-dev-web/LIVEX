---
// SPDX-FileCopyrightText: 2026 Donovan Chartrain
// SPDX-License-Identifier: GPL-3.0-or-later

import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import HeroFigure from '../../components/HeroFigure.astro';
import CtaBand from '../../components/CtaBand.astro';
import CardLink from '../../components/CardLink.astro';
import SyneSchema from '../../components/SyneSchema.astro';
import { SITE } from '../../data/site';
import { COMPONENTS_EN } from '../../data/components';
import { PROJECT_STATE, PROJECT_STATE_EN, RELEASE, RELEASE_EN } from '../../data/release';
import echosAgents from '../../assets/captures/echos-agents.png';
import launcherPrism from '../../assets/captures/launcher-prism.png';
import { Image } from 'astro:assets';
import { url } from '../../utils/url';

const nf = new Intl.NumberFormat('en-US');
const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'ScientificApplication',
  operatingSystem: 'Cross-platform',
  description: SITE.descriptionEn,
  url: new URL(url('', 'en'), Astro.site).href,
  author: { '@type': 'Person', name: SITE.author },
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  codeRepository: SITE.repo,
};
---
<BaseLayout
  lang="en"
  title="LIVEX — deterministic multi-agent simulation"
  description="Deterministic SYNE engine, ECHOS observation, PRISM rendering: a research platform for reproducible, openly documented multi-agent simulation."
  jsonLd={softwareJsonLd}
>
  <div class="w">
    <!-- Hero -->
    <section class="hero">
      <div>
        <p class="ey">Living Intelligent Virtual Ecosystem eXperience</p>
        <h1>Observe what <i>emerges.</i></h1>
        <p class="l">
          An experimental multi-agent simulation platform, from the engine that keeps the world alive to its 3D
          representation: three separate layers, explicit rules, results to observe.
        </p>
        <div class="hero-badges" style="display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px">
          <span class="badge br" style="font-size:0.78rem;padding:4px 10px">LIVEX {RELEASE.latest} released</span>
          <span class="badge br" style="font-size:0.78rem;padding:4px 10px">{SITE.license}</span>
          <span class="badge br" style="font-size:0.78rem;padding:4px 10px">{nf.format(PROJECT_STATE.tests.passed)} tests passed for release</span>
          <span class="badge br" style="font-size:0.78rem;padding:4px 10px">ECHOS coverage {PROJECT_STATE_EN.coverage.echos}</span>
        </div>
        <div class="cta">
          <a class="bt p" href={url('telecharger/', 'en')}>Download LIVEX</a>
          <a class="bt" href={url('technique/installer/', 'en')}>About the installer</a>
          <a class="bt" href={url('documentation/', 'en')}>Read the documentation</a>
          <a class="bt" href={url('participer/', 'en')}>Contribute</a>
        </div>
      </div>

      <HeroFigure lang="en" />
    </section>

    <!-- Status banner -->
    <div class="vs br" style="padding-left:16px;padding-right:16px;border:1px solid var(--ln)">
      <StatusBadge status="disponible" label={RELEASE_EN.plannedLabel} lang="en" />
      <p>
        Windows and Linux installers are available in LIVEX 1.0.0. See the <a href={url('telecharger/', 'en')}>Download</a> and <a href={url('versions/', 'en')}>Versions</a> pages for details and component limits.
      </p>
    </div>
  </div>

  <!-- Where to start -->
  <section class="block">
    <div class="w">
      <div class="sh"><b>00</b> Where to start</div>
      <h2>A path for your question.</h2>
      <p class="lead">
        LIVEX speaks to several audiences. Pick the entry that matches your question; the site keeps the same method
        (deterministic, separated, documented) at every level.
      </p>
      <div class="g3 br" style="margin-top:28px">
        <CardLink
          lang="en"
          title="Understand the project"
          text="What LIVEX is, its method and what it is not. The best entry point for a first read."
          href="comprendre/"
          cta="Read the introduction →"
        />
        <CardLink
          lang="en"
          title="Check the technology"
          text="Three-layer architecture, engine, observation, rendering. Evidence and statuses rather than promises."
          href="technique/"
          cta="Explore the architecture →"
        />
        <CardLink
          lang="en"
          title="Follow and contribute"
          text="Channels, dated journal, contribution, reporting. The project is public and welcomes feedback."
          href="suivre/"
          cta="Follow the project →"
        />
      </div>
    </div>
  </section>

  <!-- Why LIVEX -->
  <section class="block">
    <div class="w">
      <div class="sh"><b>00b</b> Why LIVEX</div>
      <h2>Three reasons to look closer.</h2>
      <p class="lead">
        The project makes no promise: it makes what happens observable, with the evidence to match.
      </p>
      <div class="g3 br" style="margin-top:28px">
        <CardLink
          lang="en"
          title="Determinism"
          text="The same starting point replays the same run, bit for bit. Results are reproducible, not narrated."
          href="technique/resultats/"
          cta="See the measures →"
        />
        <CardLink
          lang="en"
          title="Independent observation"
          text="Simulate, measure, make visible: three separate layers, linked by explicit contracts."
          href="technique/echos/"
          cta="Discover ECHOS →"
        />
        <CardLink
          lang="en"
          title="Versioned contracts"
          text="Public interfaces are frozen and versioned (snapshot 0.5.0). The contract precedes the rendering."
          href="technique/syne/"
          cta="Read the contract →"
        />
      </div>
    </div>
  </section>

  <!-- What LIVEX is -->
  <section class="block">
    <div class="w">
      <div class="sh"><b>01</b> The premise</div>
      <h2>Make legible what no one wrote.</h2>
      <p class="lead">
        LIVEX seeks to make observable a collective behaviour that was never programmed by hand. Its method rests on two
        requirements: a <strong>deterministic</strong> engine (the same starting point replays the same run, bit for bit)
        and a <strong>clean separation</strong> between what happens (the engine) and what is said about it (the
        observation).
      </p>
      <ul style="margin:16px 0 0 20px;color:var(--mu);font-size:0.88rem;line-height:1.7">
        <li><strong>Deterministic</strong> — same seed, same configuration, same trajectory.</li>
        <li><strong>Separated</strong> — simulate, measure, make visible: three independent layers.</li>
        <li><strong>Documented</strong> — every published figure has a dated internal source.</li>
      </ul>
      <div class="g3 br" style="margin-top:28px">
        <div>
          <div class="n">03</div>
          <h3>components</h3>
          <p>An engine, an observation system, a rendering module — independent, linked by explicit contracts.</p>
        </div>
        <div>
          <div class="n">1.0</div>
          <h3>public version</h3>
          <p>LIVEX 1.0.0 is published under the <code>livex-v1.0.0</code> tag. Windows and Linux installers are available.</p>
        </div>
        <div>
          <div class="n">{nf.format(PROJECT_STATE.tests.passed)}</div>
          <h3>passing tests</h3>
          <p>{PROJECT_STATE.tests.documentedTotal} cases validated for the release, 0 failures. This validates covered scenarios, not scientific outcomes.</p>
        </div>
      </div>

      <div class="fm" style="margin-top:36px">
        world <span>SYNE · simulates</span> traces <span>ECHOS · measures</span> understanding <span>PRISM · makes visible</span> <span class="q">→</span>
      </div>
    </div>
  </section>

  <!-- Architecture -->
  <section class="block" id="architecture">
    <div class="w">
      <div class="sh"><b>02</b> Architecture</div>
      <h2>Three components, explicit contracts.</h2>

      {COMPONENTS_EN.map((c) => (
        <div class="bn">
          <div>
            <span class="k">{c.acronym}</span>
            <h3>{c.name}</h3>
          </div>
          <div>
            <p>{c.summary}</p>
            <p style="margin:0 0 12px"><StatusBadge status={c.status.id} lang="en" /></p>
            <a class="bt" href={url(c.href, 'en')} aria-label={`Details about ${c.name}`}>Details →</a>
          </div>
          {c.key === 'syne' && <SyneSchema lang="en" />}
          {c.key === 'echos' && <Image src={echosAgents} alt="Preview of ECHOS: agent tracking" style="width:100%;height:auto" loading="lazy" />}
          {c.key === 'prism' && <Image src={launcherPrism} alt="Preview of PRISM rendering" style="width:100%;height:auto" loading="lazy" />}
        </div>
      ))}

      <div class="ct">Public interface contracts — snapshot 0.5.0 · run_id “run-&lt;seed&gt;-&lt;12hex&gt;” · persistence schema v5</div>
      <p class="mu" style="font-size:0.7rem">Real captures for ECHOS and PRISM (measured {PROJECT_STATE_EN.observedDate}); for SYNE, a conceptual schema — an engine has no interface to capture. None of these visuals demonstrates the published version.</p>
    </div>
  </section>

  <!-- Journal -->
  <section class="block">
    <div class="w">
      <div class="sh"><b>03</b> Journal</div>
      <h2>What moves, dated.</h2>
      <p class="lead">The journal records milestones and technical decisions, with their date. In-depth articles are added progressively.</p>
      <div class="row">
        <span class="mu">{PROJECT_STATE_EN.observedDate}</span>
        <span class="t"><a href={url('actualites/', 'en')}>Repository and component status: versions, tests, coverage.</a></span>
        <span><StatusBadge status="experimental" label="In progress" lang="en" /></span>
      </div>
      <p style="margin-top:18px"><a class="bt" href={url('actualites/', 'en')}>View the journal →</a></p>
    </div>
  </section>

  <CtaBand
    lang="en"
    eyebrow="04 · Conversion"
    title="Follow LIVEX, at your own pace."
    lead="The site is the durable source; GitHub, the place for technical transparency. No account, no cookie, no tracker — just links."
    primaryLabel="Follow the project"
    primaryHref="suivre/"
    secondaryLabel="GitHub repository ↗"
    secondaryHref={SITE.repo}
  />

  <!-- Caution -->
  <section class="block">
    <div class="w">
      <div class="cc br" style="padding:18px 20px">
        <p>
          <strong>Method note.</strong> LIVEX publishes its limitations as readily as its results. The states
          (<em>available, experimental, in development, envisaged, out of scope</em>) describe the repository, never an
          intention. No claim on this site is published without a dated internal source.
        </p>
      </div>
      <div class="ct" style="border:0;margin-top:28px">
        <a class="bt p" href={url('comprendre/', 'en')}>Read the introduction</a>
        <span style="display:inline-block;width:10px"></span>
        <a class="bt" href={SITE.repo} rel="noopener">GitHub repository ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
