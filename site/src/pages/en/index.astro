---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import HeroFigure from '../../components/HeroFigure.astro';
import { SITE } from '../../data/site';
import { COMPONENTS_EN } from '../../data/components';
import { PROJECT_STATE, PROJECT_STATE_EN, RELEASE_EN } from '../../data/release';
import { url } from '../../utils/url';

const nf = new Intl.NumberFormat('en-US');
---
<BaseLayout
  lang="en"
  title="LIVEX — multi-agent simulation"
  description="LIVEX brings together a deterministic engine (SYNE), an observation system (ECHOS) and a perceptual rendering module (PRISM). A multi-agent simulation research project, documented openly."
>
  <div class="w">
    <!-- Hero -->
    <section class="hero">
      <div>
        <p class="ey">Living Intelligent Virtual Ecosystem eXperience</p>
        <h1>Observe what <i>emerges.</i></h1>
        <p class="l">
          An experimental multi-agent simulation platform, from the engine that keeps the world alive to its 3D
          representation: three separate layers, explicit rules, results to observe.
        </p>
        <div class="cta">
          <a class="bt p" href={url('comprendre/', 'en')}>Understand LIVEX</a>
          <a class="bt" href={url('technique/', 'en')}>Explore the technology</a>
        </div>
      </div>

      <HeroFigure lang="en" />
    </section>

    <!-- Status banner -->
    <div class="vs br" style="padding-left:16px;padding-right:16px;border:1px solid var(--ln)">
      <StatusBadge status="developpement" label={RELEASE_EN.plannedLabel} lang="en" />
      <p>
        No public version is downloadable to date. The component states described below reflect the
        <strong> development repository</strong>, not a distribution. See the <a href={url('versions/', 'en')}>Versions</a> page.
      </p>
    </div>
  </div>

  <!-- What LIVEX is -->
  <section class="block">
    <div class="w">
      <div class="sh"><b>01</b> The premise</div>
      <h2>Observe, without lying about what exists.</h2>
      <p class="lead">
        LIVEX seeks to make legible a collective behaviour that was never written by hand. Its method rests on two
        requirements: a <strong>deterministic</strong> engine (the same starting point replays the same run) and a
        <strong> clean separation</strong> between what happens and what is said about it.
      </p>
      <div class="g3 br" style="margin-top:28px">
        <div>
          <div class="n">03</div>
          <h3>components</h3>
          <p>An engine, an observation system, a rendering module — independent, linked by explicit contracts.</p>
        </div>
        <div>
          <div class="n">00</div>
          <h3>public version</h3>
          <p>The project is in an exploration phase (V0.1). No release or tag has been placed.</p>
        </div>
        <div>
          <div class="n">{nf.format(PROJECT_STATE.tests.passed)}</div>
          <h3>passing tests</h3>
          <p>As of {PROJECT_STATE_EN.observedDate}, 0 failures across the local suites. A number of method, not a promise.</p>
        </div>
      </div>

      <div class="fm" style="margin-top:36px">
        world <span>SYNE · simulates</span> traces <span>ECHOS · measures</span> understanding <span>PRISM · makes visible</span> <span class="q">→</span>
      </div>
    </div>
  </section>

  <!-- Architecture -->
  <section class="block" id="architecture">
    <div class="w">
      <div class="sh"><b>02</b> Architecture</div>
      <h2>Three components, explicit contracts.</h2>

      {COMPONENTS_EN.map((c) => (
        <div class="bn">
          <div>
            <span class="k">{c.acronym}</span>
            <h3>{c.name}</h3>
          </div>
          <div>
            <p>{c.summary}</p>
            <p style="margin:0 0 12px"><StatusBadge status={c.status.id} lang="en" /></p>
            <a class="bt" href={url(c.href, 'en')}>Details →</a>
          </div>
          <div class="ph">Screenshot<br />{c.acronym}</div>
        </div>
      ))}

      <div class="ct">Public interface contracts — snapshot 0.4.0 · run_id “run-&lt;seed&gt;-&lt;12hex&gt;” · persistence schema v6</div>
      <p class="mu" style="font-size:0.7rem">The “Screenshot” placeholders will be replaced by real captures of the published version. No illustration stands in for a screenshot.</p>
    </div>
  </section>

  <!-- Journal -->
  <section class="block">
    <div class="w">
      <div class="sh"><b>03</b> Journal</div>
      <h2>What moves, dated.</h2>
      <p class="lead">The journal records milestones and technical decisions, with their date. In-depth articles are added progressively.</p>
      <div class="row">
        <span class="mu">{PROJECT_STATE_EN.observedDate}</span>
        <span class="t">No article published yet.</span>
        <span><StatusBadge status="envisage" label="Upcoming" lang="en" /></span>
      </div>
      <p style="margin-top:18px"><a class="bt" href={url('actualites/', 'en')}>View the journal →</a></p>
    </div>
  </section>

  <!-- Caution -->
  <section class="block">
    <div class="w">
      <div class="cc br" style="padding:18px 20px">
        <p>
          <strong>Method note.</strong> LIVEX publishes its limitations as readily as its results. The states
          (<em>available, experimental, in development, envisaged, out of scope</em>) describe the repository, never an
          intention. No claim on this site is published without a dated internal source.
        </p>
      </div>
      <div class="ct" style="border:0;margin-top:28px">
        <a class="bt p" href={url('comprendre/', 'en')}>Read the introduction</a>
        <span style="display:inline-block;width:10px"></span>
        <a class="bt" href={SITE.repo} rel="noopener">GitHub repository ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
