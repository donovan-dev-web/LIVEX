import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { RELEASE, RELEASE_EN } from '../../../data/release';
import { VERSIONS } from '../../../data/versions';
import { url } from '../../../utils/url';
---
<BaseLayout
  lang="en"
  title="LIVEX — Download: releases and source install"
  description="Download LIVEX 1.0.0: Windows and Linux installers, core and full variants."
>
  <PageHeader
    lang="en"
    index="11"
    eyebrow="Download"
    title="LIVEX 1.0.0 is available."
    lead="The first public release includes Windows and Linux installers in core and full variants."
    crumbs={[{ label: 'Download' }]}
  />

  <section class="block">
    <div class="w">
      <div class="pl br" style="padding:24px;margin-top:8px">
        <p style="margin:0 0 10px"><StatusBadge status="disponible" label={RELEASE_EN.plannedLabel} lang="en" /></p>
        <h2 style="margin-top:0">Installers are available</h2>
        <p>Choose a platform and profile. The <code>core</code> variant downloads optional modules when needed; <code>full</code> bundles them for offline installation.</p>
        <div class="cta">
          <a class="bt p" href={RELEASE.releaseUrl} rel="noopener">Download from GitHub ↗</a>
          <a class="bt" href={url('telecharger/installation/', 'en')}>Installation guide</a>
          <a class="bt" href={url(`versions/${VERSIONS[0].slug}/`, 'en')}>Release notes</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>11.1</b> LIVEX 1.0.0 contents</div>
      <h2>Distributed components.</h2>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Item</th><th scope="col">Expected form</th><th scope="col">State</th></tr></thead>
          <tbody>
            <tr><td>Launcher</td><td>Avalonia desktop application</td><td><StatusBadge status="disponible" lang="en" /></td></tr>
            <tr><td>SYNE</td><td>.NET simulation engine</td><td><StatusBadge status="disponible" lang="en" /></td></tr>
            <tr><td>ECHOS</td><td>Observation and analysis</td><td><StatusBadge status="disponible" lang="en" /></td></tr>
            <tr><td>PRISM</td><td>Application packaged for Windows/Linux</td><td><StatusBadge status="disponible" lang="en" /></td></tr>
            <tr><td>PRISM-LDK</td><td>Unreal plugin `PrismLdk` 1.0.0</td><td><StatusBadge status="disponible" lang="en" /></td></tr>
          </tbody>
        </table>
      </div>
      <div class="cc"><p>Release versions, known limitations and checksums are listed in the <a href={url(`versions/${VERSIONS[0].slug}/`, 'en')}>release notes</a>.</p></div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>11.2</b> In the meantime</div>
      <h2>Explore the project right now.</h2>
      <p>
        The repository is public under the GNU GPL v3.0 or later (excluding the Unreal PRISM project): you can read the code, follow the work and run the stack from
        source. Documentation remains the best entry point.
      </p>
      <div class="cta">
        <a class="bt p" href={url('documentation/', 'en')}>Documentation</a>
        <a class="bt" href={url('telecharger/installation/', 'en')}>Installation guide</a>
        <a class="bt" href="https://github.com/donovan-dev-web/LIVEX" rel="noopener">GitHub repository ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
