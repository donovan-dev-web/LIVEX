import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { PROJECT_STATE, PROJECT_STATE_EN, RELEASE, RELEASE_EN, VERSION_TABLE_EN } from '../../data/release';
import { url } from '../../utils/url';

const nf = new Intl.NumberFormat('en-US');
---
<BaseLayout
  lang="en"
  translated
  title="LIVEX — Get started in 5 minutes"
  description="Install LIVEX 1.0.0 or run SYNE, ECHOS and Launcher from source."
>
  <PageHeader
    lang="en"
    index="12b"
    eyebrow="Get started"
    title="LIVEX in 5 minutes."
    lead="Download the public LIVEX 1.0.0 installer, or follow the dedicated instructions for source development."
    crumbs={[{ label: 'Get started' }]}
  />

  <section class="block"><div class="w"><div class="cc"><p><strong>To use LIVEX:</strong> download the Windows or Linux installer from the <a href={RELEASE.releaseUrl}>1.0.0 release</a> and follow the <a href="https://github.com/donovan-dev-web/LIVEX/blob/main/docs/installer/GUIDE-UTILISATEUR.md" rel="noopener">user guide</a>. The commands below run from the repository for development.</p><p><a class="bt" href={url('technique/installer/', 'en')}>About the installer →</a></p></div></div></section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>12b.1</b> What works today</div>
      <h2>Components in LIVEX 1.0.0.</h2>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Component</th><th scope="col">Version</th><th scope="col">State</th></tr></thead>
          <tbody>
            <tr><td>{VERSION_TABLE_EN[0].component}</td><td>{VERSION_TABLE_EN[0].version}</td><td><StatusBadge status="experimental" lang="en" /></td></tr>
            <tr><td>{VERSION_TABLE_EN[1].component}</td><td>{VERSION_TABLE_EN[1].version}</td><td><StatusBadge status="experimental" lang="en" /></td></tr>
            <tr><td>{VERSION_TABLE_EN[2].component}</td><td>{VERSION_TABLE_EN[2].version}</td><td><StatusBadge status="disponible" lang="en" /></td></tr>
            <tr><td>{VERSION_TABLE_EN[3].component}</td><td>{VERSION_TABLE_EN[3].version}</td><td><StatusBadge status="disponible" lang="en" /></td></tr>
            <tr><td>{VERSION_TABLE_EN[4].component}</td><td>{VERSION_TABLE_EN[4].version}</td><td><StatusBadge status="disponible" lang="en" /></td></tr>
            <tr><td>{VERSION_TABLE_EN[5].component}</td><td>{VERSION_TABLE_EN[5].version}</td><td><StatusBadge status="disponible" lang="en" /></td></tr>
          </tbody>
        </table>
      </div>
      <p class="mu" style="margin-top:14px;font-size:0.76rem">
        <a href={RELEASE.releaseUrl}>Download LIVEX 1.0.0</a> or read the <a href={url('versions/livex-v1-0-0/', 'en')}>release notes</a>.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>12b.2</b> Prerequisites</div>
      <h2>Prerequisites for building from source.</h2>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Tool</th><th scope="col">Version</th><th scope="col">For</th></tr></thead>
          <tbody>
            <tr><td>.NET SDK</td><td>10.0.4xx</td><td>SYNE</td></tr>
            <tr><td>Python</td><td>3.11+</td><td>ECHOS</td></tr>
            <tr><td>Node.js</td><td>20+</td><td>syne-mock</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mu" style="margin-top:14px;font-size:0.76rem">Unreal Engine 5.8 is needed to develop PRISM or integrate PRISM-LDK; it is not needed to run the packaged PRISM application.</p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>12b.3</b> Start</div>
      <h2>The stack in one command.</h2>
      <p>From the repository root:</p>
      <pre><code>./scripts/dev-stack.sh</code></pre>
      <p>
        The script prepares the Python environment, builds SYNE, then starts the ECHOS API (port <code>5000</code>),
        SYNE (control <code>5181</code>, WebSocket <code>5180</code>) and ECHOS ingestion. SYNE stays in the
        <code>Idle</code> state until the <code>Start</code> command.
      </p>
      <p class="mu" style="font-size:0.76rem">
        On Windows, run the script from Git Bash or WSL and use
        <code>echos/.venv/Scripts/python.exe</code> for Python commands.
      </p>
      <p style="margin-top:18px">
        <a class="bt" href={url('telecharger/installation/', 'en')}>Full installation guide →</a>
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>12b.4</b> Verify</div>
      <h2>0 failures expected.</h2>
      <pre><code># SYNE
cd syne &amp;&amp; dotnet test Syne.sln --configuration Release

# ECHOS
echos/.venv/bin/python -m pytest -q</code></pre>
      <p>For the release, <strong>{nf.format(PROJECT_STATE.tests.documentedTotal)} cases were validated</strong>: {nf.format(PROJECT_STATE.tests.passed)} passed, {PROJECT_STATE.tests.ignored} skipped and 0 failures.</p>
      <p style="margin-top:18px">
        <a class="bt" href={url('etat-du-projet/', 'en')}>See project state →</a>
      </p>
    </div>
  </section>
</BaseLayout>
