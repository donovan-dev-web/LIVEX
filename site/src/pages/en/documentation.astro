import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../utils/url';

const repo = 'https://github.com/donovan-dev-web/LIVEX/blob/main';
const groups = [
  {
    title: 'Overview',
    items: [
      { label: 'Vision', href: `${repo}/docs/presentation/VISION.md` },
      { label: 'Getting started in 5 minutes', href: url('getting-started/', 'en') },
      { label: 'FAQ', href: url('faq/', 'en') },
      { label: 'Glossary', href: url('comprendre/glossaire/', 'en') },
      { label: 'Scope and ethics', href: `${repo}/docs/presentation/ETHICS_AND_SCOPE.md` },
    ],
  },
  {
    title: 'Architecture',
    items: [
      { label: 'Overview', href: url('technique/', 'en') },
      { label: 'Technical architecture', href: `${repo}/docs/ARCHITECTURE.md` },
      { label: 'Inter-component contracts', href: `${repo}/docs/COMMUNICATION.md` },
      { label: 'Monograph (PDF)', href: `${repo}/docs/presentation/Monographie-Prototype-V01/LIVEX-Monographie_SnapV0-1.pdf` },
      { label: 'Full monograph', href: url('monographie/', 'en') },
    ],
  },
  {
    title: 'Components',
    items: [
      { label: 'SYNE', href: url('technique/syne/', 'en') },
      { label: 'ECHOS', href: url('technique/echos/', 'en') },
      { label: 'PRISM', href: url('technique/prism/', 'en') },
      { label: 'SYNE guide', href: `${repo}/syne/README.md` },
    ],
  },
  {
    title: 'Governance',
    items: [
      { label: 'Roadmap', href: url('feuille-de-route/', 'en') },
      { label: 'Project status', href: `${repo}/docs/governance/LIVEX-STATUS.md` },
      { label: 'Versioning', href: `${repo}/VERSIONING.md` },
      { label: 'Gitflow', href: `${repo}/docs/governance/GITFLOW.md` },
    ],
  },
  {
    title: 'Contribute',
    items: [
      { label: 'Contributing', href: `${repo}/CONTRIBUTING.md` },
      { label: 'Code of conduct', href: `${repo}/CODE_OF_CONDUCT.md` },
      { label: 'Security', href: `${repo}/SECURITY.md` },
      { label: 'Support', href: `${repo}/SUPPORT.md` },
    ],
  },
];
---
<BaseLayout
  lang="en"
  translated
  title="LIVEX — Documentation: architecture, guides, governance"
  description="LIVEX documentation portal: overview, architecture, components, governance and contribution — repository, monograph and guides in one place."
>
  <PageHeader
    lang="en"
    index="15"
    eyebrow="Documentation"
    title="Everything is documented, and verifiable."
    lead="Documentation lives in the repository, versioned alongside the code. This portal gathers its main entry points, organised by intent, so you can go straight to what you need."
    crumbs={[{ label: 'Documentation' }]}
  />

  <section class="block">
    <div class="w">
      <h2>The main entry points, by intent.</h2>
      <p>Understand the project, build with it, follow its governance or contribute: pick an intent, then follow the
        link. The full detail stays in the repository.</p>
      <div class="g2" style="margin-top:20px">
        {groups.map((g) => (
          <div class="pl br" style="padding:20px">
            <h3 style="margin-bottom:10px">{g.title}</h3>
            <ul style="list-style:none;padding:0;margin:0">
              {g.items.map((it) => (
                <li style="padding:4px 0;font-size:0.8rem">
                  <a href={it.href} rel={it.href.startsWith('http') ? 'noopener' : undefined}>{it.label}{it.href.startsWith('http') ? ' ↗' : ''}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="cc" style="margin-top:24px"><p>The repository's reference portal:
        <a href={`${repo}/docs/README.md`} rel="noopener">docs/README.md</a>. For a short view without leaving the
        site: <a href={url('technique/', 'en')}>Architecture</a>,
        <a href={url('feuille-de-route/', 'en')}>Roadmap</a> and
        <a href={url('faq/', 'en')}>FAQ</a>.</p></div>
    </div>
  </section>
</BaseLayout>
