import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../utils/url';

const repo = 'https://github.com/donovan-dev-web/LIVEX';
const blob = `${repo}/blob/main`;
---
<BaseLayout
  lang="en"
  translated
  title="Contribute — rules, security and support"
  description="Contributing to LIVEX: contribution rules, code of conduct, private security reporting and support. Public repository under the GNU GPL v3.0 or later (excluding the Unreal PRISM project)."
>
  <PageHeader
    lang="en"
    index="19"
    eyebrow="Contribute"
    title="Contributing, by the rules."
    lead="The repository is public under the GNU GPL v3.0 or later (excluding the Unreal PRISM project). A solo project gladly welcomes contributions, provided a simple framework is respected — the four documents below define it."
    crumbs={[{ label: 'Contribute' }]}
  />

  <section class="block">
    <div class="w">
      <p class="mu">
        Start with CONTRIBUTING.md: it sets out the branches, commit messages and expected scope of pull requests.
        The other three documents cover the social framework, security and getting help.
      </p>
      <div class="g2">
        <div class="pl br" style="padding:20px">
          <h3>Contributing</h3>
          <p class="mu">Branches, commit messages, PR scope. Read this before your first contribution — it is the document that prevents the most back-and-forth.</p>
          <a class="bt" href={`${blob}/CONTRIBUTING.md`} rel="noopener">CONTRIBUTING.md ↗</a>
        </div>
        <div class="pl br" style="padding:20px">
          <h3>Code of conduct</h3>
          <p class="mu">Exchanges are held in a respectful framework. It applies to every interaction in the project, issues included.</p>
          <a class="bt" href={`${blob}/CODE_OF_CONDUCT.md`} rel="noopener">CODE_OF_CONDUCT.md ↗</a>
        </div>
        <div class="pl br" style="padding:20px">
          <h3>Security</h3>
          <p class="mu">A vulnerability is reported privately, before any public discussion. The procedure is detailed there.</p>
          <a class="bt" href={`${blob}/SECURITY.md`} rel="noopener">SECURITY.md ↗</a>
        </div>
        <div class="pl br" style="padding:20px">
          <h3>Support</h3>
          <p class="mu">Where to ask a question, open an issue, or find help — without assuming any response time.</p>
          <a class="bt" href={`${blob}/SUPPORT.md`} rel="noopener">SUPPORT.md ↗</a>
        </div>
      </div>

      <div class="cc" style="margin-top:26px">
        <p><strong>Reporting a vulnerability:</strong> open a private advisory via
          <a href={`${repo}/security/advisories/new`} rel="noopener">GitHub Security Advisories</a> — do not expose the
          flaw in a public issue.</p>
      </div>
      <p style="margin-top:22px">
        <a class="bt" href={url('suivre/', 'en')}>Follow the project</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={url('licence/', 'en')}>Licence and reuse</a>
      </p>
    </div>
  </section>
</BaseLayout>
