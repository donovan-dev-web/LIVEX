import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SyneSchema from '../../../components/SyneSchema.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { url } from '../../../utils/url';
---
<BaseLayout
  lang="en"
  translated
  title="SYNE: deterministic simulation engine"
  description="SYNE, LIVEX's deterministic multi-agent cognition engine: agents, explicit rules, 0.6.0 observability contract and bit-for-bit replayability from a seed."
>
  <PageHeader
    lang="en"
    index="06"
    eyebrow="Architecture · SYNE"
    title="The engine."
    lead="SYNE (Systems & Emergent Network Engine) owns agent cognition and the simulation clock. It is deterministic: from the same seed, a run replays identically."
    crumbs={[{ label: 'Architecture', href: 'technique/' }, { label: 'SYNE' }]}
  />

  <div class="w" style="padding-top:8px">
    <TableOfContents lang="en" />
  </div>

  <section class="block">
    <div class="w">
      <p style="margin-top:0"><StatusBadge status="experimental" lang="en" /> <span class="mu">SYNE 0.18.0 · .NET engine (repository)</span></p>
      <div class="cc"><p>Experimental: the engine is functional in the repository (813 tests on 15 November 2026), but no public distribution exists to date.</p></div>

      <div class="sh"><b>6.1</b> Role</div>
      <h2>Set rules, let them play out.</h2>
      <p>
        In V2, SYNE no longer owns the <strong>world</strong>: it carries agent <strong>cognition</strong> and the
        clock, while PRISM arbitrates space, matter and physical time. At each tick, decisions follow explicit rules and
        the applied observations come back from PRISM: no decision is left to unrecorded randomness.
      </p>
      <p>
        The benefit for the researcher: rules are readable, versioned and replayable. A result can be re-read,
        discussed and reproduced by a third party, without relying on an opaque engine.
      </p>
      <p>
        The engine publishes a <strong>0.6.0 observability contract</strong>: snapshots, deltas and an event trace. It is
        this trace, not the engine, that drives observation; ECHOS derives its measures from it without rewriting state.
      </p>

      <p>
        An engine has no interface: there is therefore no screenshot to show. Where an image helps, the site shows a
        <strong>conceptual schema</strong> — as the home hero does.
      </p>

      <div class="pl br" style="margin-top:20px">
        <SyneSchema lang="en" variant="full" />
        <small><b>Fig. 1</b> — The SYNE computation loop: world, local perception, decision, action, and the traces it produces. <strong>Conceptual illustration, not a capture.</strong></small>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>6.2</b> Determinism</div>
      <h2>The same start, the same run.</h2>
      <p>
        <strong>Bit-for-bit</strong> determinism is a contract: replaying a run with the same seed must reproduce
        exactly the same trajectory. This is what makes a result verifiable and a measurement reproducible.
      </p>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Element</th><th scope="col">Value</th></tr></thead>
          <tbody>
            <tr><td>Engine version</td><td>0.18.0</td></tr>
            <tr><td>Run identifier</td><td><code>run-&lt;seed&gt;-&lt;12hex&gt;</code></td></tr>
            <tr><td>Observability contract</td><td>0.6.0</td></tr>
            <tr><td>Snapshot</td><td><code>schemaVersion</code> 5</td></tr>
            <tr><td>Persistence schema</td><td>v5</td></tr>
            <tr><td>Measured cost (R3, 100 agents)</td><td>30.5 ms/tick, checksum <code>855fdc2e1387e8d3</code> reproduced twice</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>6.3</b> Next</div>
      <p style="margin-top:0">
        <a class="bt" href={url('technique/echos/', 'en')}>ECHOS: observation →</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={url('technique/', 'en')}>Overview</a>
      </p>
    </div>
  </section>
</BaseLayout>