import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import SyneSchema from '../../../components/SyneSchema.astro';
import { Image } from 'astro:assets';
import echosAgents from '../../../assets/captures/echos-agents.png';
import { COMPONENTS_EN } from '../../../data/components';
import { url } from '../../../utils/url';
---
<BaseLayout
  lang="en"
  title="LIVEX architecture: SYNE, ECHOS, PRISM"
  description="LIVEX V2 target architecture: SYNE cognition, PRISM’s authoritative physical world and ECHOS analysis, linked by versioned contracts."
>
  <PageHeader
    lang="en"
    index="05"
    eyebrow="Architecture"
    title="Three components, separate responsibilities."
    lead="In the V2 target, SYNE owns cognition, PRISM the physical world and ECHOS observation. The PRISM viewer reads the world without governing the simulation."
    crumbs={[{ label: 'Architecture' }]}
  />

  <div class="w" style="padding-top:8px">
    <TableOfContents lang="en" />
  </div>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.1</b> Overview</div>
      <h2>From intention to observable world.</h2>
      <div class="fm">
        cognition <span>SYNE</span> physical world <span>PRISM</span> analysis <span>ECHOS</span>
      </div>
      <p>
        This architecture describes the planned V2 scope. SYNE and PRISM exchange commands, observations and events;
        ECHOS receives their traces and PRISM publishes a read stream. The viewer is optional. Implementation and
        validation information will be revised before publication.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.2</b> Components</div>
      <h2>Components and their planned roles.</h2>
      {COMPONENTS_EN.map((c) => (
        <div class="bn">
          <div>
            <span class="k">{c.acronym}</span>
            <h3>{c.name}</h3>
          </div>
          <div>
            <p>{c.summary}</p>
            <p style="margin:0 0 6px"><StatusBadge status={c.status.id} lang="en" /></p>
            <p class="mu" style="margin:0 0 12px;font-size:0.76rem">{c.status.note}</p>
            <a class="bt" href={url(c.href, 'en')} aria-label={`Details about ${c.name}`}>Details →</a>
          </div>
          {c.key === 'syne' && <SyneSchema lang="en" />}
          {c.key === 'echos' && <Image src={echosAgents} alt="ECHOS capture: tracking of observed agents" style="width:100%;height:auto" loading="lazy" />}
          {c.key === 'prism' && <p class="mu">The associated capture shows the V1 generation; it does not illustrate the planned V2 viewer.</p>}
        </div>
      ))}
      <p class="mu" style="font-size:0.7rem">The SYNE diagram is conceptual. The ECHOS capture and the earlier PRISM capture show V1/development versions; they do not demonstrate delivery of the V2 target.</p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.3</b> Interface contracts</div>
      <h2>Planned contract and data flows.</h2>
      <div class="ov">
        <table class="tb">
          <thead>
            <tr><th scope="col">Contract</th><th scope="col">Version / format</th><th scope="col">Note</th></tr>
          </thead>
          <tbody>
            <tr><td>SYNE↔PRISM contract (V2 target)</td><td>1.0.0</td><td>Commands, observations, events and world read stream; target described in PRISM specifications.</td></tr>
            <tr><td>Run identifier format</td><td><code>run-&lt;seed&gt;-&lt;12hex&gt;</code></td><td>Seed is included in the identifier; ECHOS does not derive it from the ID.</td></tr>
            <tr><td>ECHOS persistence schema</td><td>SQLite v6</td><td>Additive migration <code>mean_food</code>/<code>mean_water</code>.</td></tr>
            <tr><td>PRISM read stream</td><td>V2 target</td><td>Regional deltas and world state for ECHOS and the optional viewer.</td></tr>
          </tbody>
        </table>
      </div>
      <div class="cc" style="margin-top:22px">
        <p>These contracts evolve under Semantic Versioning. Any breaking change is reported in the
          <a href="https://github.com/donovan-dev-web/LIVEX/blob/main/CHANGELOG.md" rel="noopener">CHANGELOG</a>.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.4</b> Repository organisation</div>
      <h2>A monorepo, isolated components.</h2>
      <div class="ov">
        <table class="tb">
          <thead>
            <tr><th scope="col">Directory</th><th scope="col">Content</th><th scope="col">Status</th></tr>
          </thead>
          <tbody>
            <tr><td><code>syne/</code></td><td>Agent cognition and decisions</td><td>V2 target</td></tr>
            <tr><td><code>echos/</code></td><td>Observation, analysis, headless API (Python package)</td><td><StatusBadge status="experimental" lang="en" /></td></tr>
            <tr><td><code>prism/</code></td><td>Headless .NET physical world; optional Silk.NET viewer</td><td>V2 target</td></tr>
            <tr><td><code>launcher/</code></td><td>Desktop application (Avalonia) — orchestration and presentation</td><td><StatusBadge status="developpement" lang="en" /></td></tr>
            <tr><td><code>docs/</code></td><td>Monograph, architecture, governance, documentation</td><td>—</td></tr>
            <tr><td><code>site/</code></td><td>This static showcase site (Astro)</td><td>—</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>5.5</b> Further reading</div>
      <h2>Orchestration and evidence.</h2>
      <div class="g2">
        <div class="pl br" style="padding:20px">
          <h3>Launcher</h3>
          <p class="mu">The orchestration layer: drive, combine and archive work carried out with SYNE, ECHOS and PRISM from a single interface.</p>
          <a class="bt" href={url('technique/launcher/', 'en')}>The Launcher →</a>
        </div>
        <div class="pl br" style="padding:20px">
          <h3>Reproducibility and measurements</h3>
          <p class="mu">Tests, coverage and benchmarks: what is claimed is measured, dated and reproducible — or flagged as unverified.</p>
          <a class="bt" href={url('technique/resultats/', 'en')}>See results →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
