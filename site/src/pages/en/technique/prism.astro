import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { Image } from 'astro:assets';
import { url } from '../../../utils/url';
import prismShot from '../../../assets/captures/launcher-prism.png';
---
<BaseLayout
  lang="en"
  translated
  title="PRISM: perceptual rendering (beyond V0.2)"
  description="PRISM makes the simulated LIVEX world perceptible: Unreal project and PRISM-LDK integration plugin. Component in development, out of scope for V0.2."
>
  <PageHeader
    lang="en"
    index="08"
    eyebrow="Architecture · PRISM"
    title="Rendering."
    lead="PRISM (Perceptual Rendering & Interactive Simulation Module) gives form and presence to the simulated world. It is the least advanced component of the project, and we say so."
    crumbs={[{ label: 'Architecture', href: 'technique/' }, { label: 'PRISM' }]}
  />

  <div class="w" style="padding-top:8px">
    <TableOfContents lang="en" />
  </div>

  <section class="block">
    <div class="w">
      <p style="margin-top:0"><StatusBadge status="developpement" lang="en" /> <span class="mu">Unreal project and PRISM-LDK plugin</span></p>
      <div class="cc"><p><strong>PRISM-LDK</strong> (LIVEX Development Kit) is the core of 3D representation: the Unreal plugin that translates SYNE's logical data into a 3D graphical representation, <strong>realised and packaged as version 0.1.0</strong>. <strong>PRISM</strong> is the Unreal project built around it: the default stylised representation, according to the author's vision. PRISM remains <strong>out of scope for V0.2</strong>: no playable rendering experience is claimed yet.</p></div>

      <div class="sh"><b>8.1</b> Role</div>
      <h2>Making dynamics visible.</h2>
      <p>
        Where SYNE computes and ECHOS measures, PRISM <strong>makes things perceptible</strong>: it transforms the world state
        and its events into an observable and interactive scene. It consists of an Unreal project and an integration
        plugin, <strong>PRISM-LDK</strong>.
      </p>

      <figure class="shot">
        <Image src={prismShot} alt="PRISM rendering preview"  loading="lazy" />
        <figcaption>Capture — PRISM rendering preview (work-in-progress).</figcaption>
      </figure>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>8.2</b> State</div>
      <h2>The youngest component.</h2>
      <p>
        PRISM is a work-in-progress. No timeline is promised: rendering is deliberately out of scope for V0.2, so that
        validation of the engine and observation is not diluted.
      </p>
      <p class="mu" style="font-size:0.82rem">
        The project's roadmap is authoritative for the steps ahead.
      </p>
      <div class="cc">
        <p>Do not assume that local protections in the engine or mock secure distribution of the PRISM project. See <a href="https://github.com/donovan-dev-web/LIVEX/blob/main/SECURITY.md" rel="noopener">SECURITY.md</a>.</p>
      </div>
      <p style="margin-top:18px"><a class="bt" href={url('technique/', 'en')}>← Overview</a></p>
    </div>
  </section>
</BaseLayout>