import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { PROJECT_STATE, PROJECT_STATE_EN, RELEASE, VERSION_TABLE_EN } from '../../data/release';

const nf = new Intl.NumberFormat('en-US');
const ciJobs = PROJECT_STATE.ci.split(' ')[0];
---
<BaseLayout
  lang="en"
  translated
  title="LIVEX — Component versions and project status"
  description={`LIVEX component versions (SYNE, ECHOS, PRISM, Launcher), project state as of ${PROJECT_STATE_EN.observedDate} and versioning policy. No public release.`}
>
  <PageHeader
    lang="en"
    index="13"
    eyebrow="Versions"
    title="Where the project stands."
    lead="A factual, dated state, component by component. Each module moves at its own pace: the global version V0.2 is in preparation, with no public release."
    crumbs={[{ label: 'Versions' }]}
  />

  <section class="block">
    <div class="w">
      <div class="cc" style="padding:18px 20px">
        <p><strong>No public release, no tags.</strong> The global version <strong>{RELEASE.planned}</strong> is
          in preparation. See <a href={RELEASE.releasesUrl} rel="noopener">GitHub Releases</a>.</p>
      </div>

      <div class="sh"><b>13.1</b> Versions by component</div>
      <h2>Four components, four versions.</h2>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Component</th><th scope="col">Version</th><th scope="col">Note</th><th scope="col">Status</th></tr></thead>
          <tbody>
            <tr><td>SYNE</td><td>{VERSION_TABLE_EN[0].version}</td><td>{VERSION_TABLE_EN[0].note}</td><td><StatusBadge status="experimental" lang="en" /></td></tr>
            <tr><td>ECHOS</td><td>{VERSION_TABLE_EN[1].version}</td><td>{VERSION_TABLE_EN[1].note}</td><td><StatusBadge status="experimental" lang="en" /></td></tr>
            <tr><td>PRISM</td><td>{VERSION_TABLE_EN[2].version}</td><td>{VERSION_TABLE_EN[2].note}</td><td><StatusBadge status="developpement" lang="en" /></td></tr>
            <tr><td>Launcher</td><td>{VERSION_TABLE_EN[3].version}</td><td>{VERSION_TABLE_EN[3].note}</td><td><StatusBadge status="developpement" lang="en" /></td></tr>
          </tbody>
        </table>
      </div>
      <p class="mu" style="margin-top:14px;font-size:0.76rem">
        Independent Semantic Versioning per component, combined with a global marker for cross-cutting deliveries.
        Details: <a href="https://github.com/donovan-dev-web/LIVEX/blob/main/VERSIONING.md" rel="noopener">VERSIONING.md</a>.
        Each published version will get a dedicated page (<code>/versions/&lt;version&gt;/</code>); none exists yet, as
        no public tag has been set.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>13.2</b> Project state</div>
      <h2>Measured on {PROJECT_STATE_EN.observedDate}.</h2>
      <div class="g3 br">
        <div>
          <div class="n">{nf.format(PROJECT_STATE.tests.passed)}</div>
          <h3>passing tests</h3>
          <p>Measured on {PROJECT_STATE_EN.observedDate}: 0 failures in the unit and integration suites.</p>
        </div>
        <div>
          <div class="n">{nf.format(PROJECT_STATE.trackedFiles)}</div>
          <h3>tracked files</h3>
          <p>{nf.format(PROJECT_STATE.loc.total)} lines analysed (source and tests).</p>
        </div>
        <div>
          <div class="n">{ciJobs}</div>
          <h3>CI jobs green</h3>
          <p>{PROJECT_STATE_EN.ci}.</p>
        </div>
      </div>

      <div class="ov" style="margin-top:28px">
        <table class="tb">
          <thead><tr><th scope="col">Indicator</th><th scope="col">Value</th></tr></thead>
          <tbody>
            <tr><td>Analysed reference</td><td><code>{PROJECT_STATE.branch}</code> · {PROJECT_STATE.commit}</td></tr>
            <tr><td>Tests per component</td><td>{PROJECT_STATE.tests.byComponent.map((c) => `${c.name} ${nf.format(c.value)}`).join(' · ')}</td></tr>
            <tr><td>ECHOS coverage</td><td>{PROJECT_STATE.coverage.echos}</td></tr>
            <tr><td>SYNE coverage (aggregated)</td><td>{PROJECT_STATE.coverage.syne} (Core {PROJECT_STATE.coverage.syneCore}, Console {PROJECT_STATE.coverage.syneConsole})</td></tr>
            <tr><td>Windows</td><td>{PROJECT_STATE_EN.windows}</td></tr>
            <tr><td>Release</td><td>No public release — {RELEASE.planned} in preparation</td></tr>
          </tbody>
        </table>
      </div>
      <div class="cc"><p>These figures describe a development repository, not a product: they constitute neither
        functional validation nor a promise of stability.</p></div>

      <p style="margin-top:18px"><a class="bt" href={RELEASE.changelogUrl} rel="noopener">Changelog ↗</a></p>
    </div>
  </section>
  <section class="block">
    <div class="w">
      <div class="sh"><b>13.3</b> Release notes</div>
      <h2>The changelog and the tags.</h2>
      <p>
        No public release exists yet, so no version sheet exists yet (<code>/versions/&lt;version&gt;/</code>). The
        repository changelog and the GitHub tags remain the reference in the meantime.
      </p>
      <p style="margin-top:18px">
        <a class="bt" href={RELEASE.changelogUrl} rel="noopener">Read CHANGELOG.md &rarr;</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={RELEASE.releasesUrl} rel="noopener">GitHub tags and releases &rarr;</a>
      </p>
    </div>
  </section>
</BaseLayout>
