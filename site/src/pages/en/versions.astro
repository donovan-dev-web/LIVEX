import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { PROJECT_STATE, PROJECT_STATE_EN, RELEASE, VERSION_TABLE_EN } from '../../data/release';

const nf = new Intl.NumberFormat('en-US');
---
<BaseLayout
  lang="en"
  translated
  title="LIVEX — Component versions and project status"
  description={`LIVEX component versions and project state as of ${PROJECT_STATE_EN.observedDate}. LIVEX 1.0.0 is publicly released.`}
>
  <PageHeader
    lang="en"
    index="13"
    eyebrow="Versions"
    title="Where the project stands."
    lead="A factual, dated state, component by component. The public LIVEX 1.0.0 release is available."
    crumbs={[{ label: 'Versions' }]}
  />

  <section class="block">
    <div class="w">
      <div class="cc" style="padding:18px 20px">
        <p><strong>LIVEX {RELEASE.latest} is released.</strong> See the <a href={RELEASE.releaseUrl} rel="noopener">release downloads</a>.</p>
      </div>

      <div class="sh"><b>13.1</b> Versions by component</div>
      <h2>Versions of the distributed components.</h2>
      <div class="ov">
        <table class="tb">
          <thead><tr><th scope="col">Component</th><th scope="col">Version</th><th scope="col">Note</th><th scope="col">Status</th></tr></thead>
          <tbody>
            {VERSION_TABLE_EN.map((component) => <tr><td>{component.component}</td><td>{component.version}</td><td>{component.note}</td><td><StatusBadge status="disponible" lang="en" /></td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="mu" style="margin-top:14px;font-size:0.76rem">
        Independent Semantic Versioning per component, combined with a global marker for cross-cutting deliveries.
        Details: <a href="https://github.com/donovan-dev-web/LIVEX/blob/main/VERSIONING.md" rel="noopener">VERSIONING.md</a>.
        <a href="../versions/livex-v1-0-0/">Read the LIVEX 1.0.0 release page</a> or browse the release tags.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>13.2</b> Project state</div>
      <h2>Measured on {PROJECT_STATE_EN.observedDate}.</h2>
      <div class="g3 br">
        <div>
          <div class="n">{nf.format(PROJECT_STATE.tests.passed)}</div>
          <h3>tests passing for the release</h3>
          <p>{nf.format(PROJECT_STATE.tests.documentedTotal)} cases validated across all components: {nf.format(PROJECT_STATE.tests.passed)} passed, {PROJECT_STATE.tests.ignored} skipped, {PROJECT_STATE.tests.failed} failed.</p>
        </div>
        <div>
          <div class="n">{nf.format(PROJECT_STATE.filesScanned)}</div>
          <h3>files analysed</h3>
          <p>{nf.format(PROJECT_STATE.loc.total)} lines of code per Tokei 13.0.0.</p>
        </div>
        <div>
          <div class="n">1.0.0</div>
          <h3>public release</h3>
          <p>Tag <code>livex-v1.0.0</code>, published on 31 October 2026.</p>
        </div>
      </div>

      <div class="ov" style="margin-top:28px">
        <table class="tb">
          <thead><tr><th scope="col">Indicator</th><th scope="col">Value</th></tr></thead>
          <tbody>
            <tr><td>Analysed reference</td><td><code>{PROJECT_STATE.branch}</code> · {PROJECT_STATE.commit}</td></tr>
            <tr><td>Tests per component</td><td>{PROJECT_STATE.tests.byComponent.map((c) => `${c.name} ${nf.format(c.value)}`).join(' · ')}</td></tr>
            <tr><td>PRISM / PRISM-LDK</td><td>{PROJECT_STATE.tests.prismSpecs} Automation Specs: 71 passed, 5 passed with warnings</td></tr>
            <tr><td>Installer</td><td>{PROJECT_STATE.tests.installerCases} tests executed and passed</td></tr>
            <tr><td>ECHOS coverage</td><td>{PROJECT_STATE_EN.coverage.echos}</td></tr>
            <tr><td>SYNE coverage (aggregated)</td><td>{PROJECT_STATE_EN.coverage.syne} (Core {PROJECT_STATE_EN.coverage.syneCore}, Console {PROJECT_STATE_EN.coverage.syneConsole})</td></tr>
            <tr><td>CI</td><td>{PROJECT_STATE_EN.ci}</td></tr>
            <tr><td>Release</td><td>LIVEX {RELEASE.latest} — tag `livex-v1.0.0`</td></tr>
          </tbody>
        </table>
      </div>
      <div class="cc"><p>The public release is available. These counters summarize the measured checkout and the tests run for the release; they do not guarantee behaviour outside covered scenarios or scientific outcomes.</p></div>

      <p style="margin-top:18px"><a class="bt" href={RELEASE.changelogUrl} rel="noopener">Changelog ↗</a></p>
    </div>
  </section>
  <section class="block">
    <div class="w">
      <div class="sh"><b>13.3</b> Release notes</div>
      <h2>Release notes, changelog and tags.</h2>
      <p>
        The LIVEX 1.0.0 page summarizes changes and links to packages. The repository changelog and GitHub tag remain the references.
      </p>
      <p style="margin-top:18px">
        <a class="bt" href={RELEASE.changelogUrl} rel="noopener">Read CHANGELOG.md →</a>
        <span style="display:inline-block;width:8px"></span>
        <a class="bt" href={RELEASE.releasesUrl} rel="noopener">GitHub tags and releases →</a>
      </p>
    </div>
  </section>
</BaseLayout>
