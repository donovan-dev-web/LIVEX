import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../data/site';
import { url } from '../utils/url';
---
<BaseLayout
  title="Accessibilité — objectif WCAG 2.2 niveau AA"
  description="Déclaration d'accessibilité du site LIVEX : objectif WCAG 2.2 niveau AA, mesures mises en œuvre, limites connues et signalement d'un défaut."
>
  <PageHeader
    index="24"
    eyebrow="Accessibilité"
    title="Rendre le site lisible pour tous."
    lead="Ce site vise le niveau AA des règles WCAG 2.2. C'est une déclaration volontaire : elle décrit des engagements tenus, et nomme ce qui reste perfectible."
    crumbs={[{ label: 'Accessibilité' }]}
  />

  <section class="block">
    <div class="w">
      <div class="sh"><b>24.1</b> Objectif de conformité</div>
      <h2>WCAG 2.2, niveau AA.</h2>
      <p>
        Le site LIVEX vise la conformité au niveau AA des <em>Web Content Accessibility Guidelines</em> (WCAG) 2.2. Il
        s'agit d'une <strong>déclaration volontaire</strong>, sans obligation légale attachée à ce projet personnel : la
        démarche est choisie, pas subie.
      </p>
      <div class="cc"><p>Nous ne déclarons pas une conformité totale. Une déclaration honnête énonce aussi ce qui n'est
        pas encore vérifié.</p></div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>24.2</b> Mesures mises en œuvre</div>
      <h2>Ce qui a été fait.</h2>
      <div class="g2">
        <div class="pl br" style="padding:18px"><h3>Contrastes</h3><p class="mu" style="margin:0">Palette et tokens vérifiés pour le contraste texte/fond, en thème clair comme en thème sombre.</p></div>
        <div class="pl br" style="padding:18px"><h3>Focus visible</h3><p class="mu" style="margin:0">Chaque élément interactif possède un indicateur de focus visible au clavier.</p></div>
        <div class="pl br" style="padding:18px"><h3>Couleur jamais seule</h3><p class="mu" style="margin:0">Les statuts combinent couleur, symbole et texte — jamais la seule couleur.</p></div>
        <div class="pl br" style="padding:18px"><h3>Textes alternatifs</h3><p class="mu" style="margin:0">Images et figures portent une alternative pertinente ; les schémas sont décrits en texte.</p></div>
        <div class="pl br" style="padding:18px"><h3>Navigation clavier</h3><p class="mu" style="margin:0">Le site se parcourt entièrement au clavier, avec un lien d'évitement vers le contenu.</p></div>
        <div class="pl br" style="padding:18px"><h3>Thème clair / sombre</h3><p class="mu" style="margin:0">Thème clair par défaut ; bascule sombre manuelle, mémorisée localement.</p></div>
        <div class="pl br" style="padding:18px"><h3>Mouvement réduit</h3><p class="mu" style="margin:0">Le réglage système <code>prefers-reduced-motion</code> est respecté ; aucune animation continue.</p></div>
        <div class="pl br" style="padding:18px"><h3>Structure sémantique</h3><p class="mu" style="margin:0">Titres hiérarchisés, un seul <code>h1</code> par page, régions et repères nommés.</p></div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>24.3</b> Limites connues</div>
      <h2>Ce qui reste à éprouver.</h2>
      <p>
        L'accessibilité a été prise en compte à la conception, mais aucun audit externe n'a encore été conduit. Les
        vérifications automatisées ne suffisent pas : certains usages (lecteurs d'écran, navigation vocale) demandent
        une évaluation humaine qui reste à faire.
      </p>
      <p class="mu" style="font-size:0.78rem">
        La référence appliquée ici est la version 2.2 des
        <a href="https://www.w3.org/TR/WCAG22/" rel="noopener">Web Content Accessibility Guidelines ↗</a> (W3C).
      </p>
    </div>
  </section>

  <section class="block">
    <div class="w">
      <div class="sh"><b>24.4</b> Signaler un défaut</div>
      <h2>Votre retour améliore le site.</h2>
      <p>
        Si vous rencontrez une barrière d'accessibilité — contraste insuffisant, élément inatteignable au clavier,
        alternative manquante — signalez-le. Précisez si possible la page, le navigateur ou l'outil d'assistance
        utilisé. Les signalements sont traités comme des issues publiques du dépôt.
      </p>
      <div class="ov">
        <table class="tb">
          <thead><tr><th>Élément</th><th>Valeur</th></tr></thead>
          <tbody>
            <tr><td>Moyen de signalement</td><td><a href={SITE.repo + '/issues'} rel="noopener">Issues GitHub ↗</a></td></tr>
            <tr><td>Dernière revue d'accessibilité</td><td>12 octobre 2026</td></tr>
            <tr><td>Référentiel visé</td><td>WCAG 2.2, niveau AA (déclaration volontaire)</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top:18px"><a class="bt" href={url('plan-du-site/')}>Plan du site →</a></p>
    </div>
  </section>
</BaseLayout>
