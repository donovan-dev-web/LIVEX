---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { url, absoluteUrl } from '../utils/url';
import {
  useTranslations,
  stripLangFromPath,
  publishedLangs,
  type Lang,
} from '../i18n/ui';

import fontSerif from '../assets/fonts/instrument-serif-latin-400-normal.woff2?url';
import fontMono from '../assets/fonts/jetbrains-mono-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  lang?: Lang;
  /** Bandeau « traduction automatique » (pages EN de niveau 2). */
  translated?: boolean;
  /**
   * Traductions existantes, par langue (chemin sans préfixe de langue).
   * Pour une page FR sans équivalent EN (ex. articles du journal, FR-only),
   * passer `{ en: 'actualites/' }` : le sélecteur et `hreflang` pointent alors
   * vers la page EN la plus proche au lieu d'une page inexistante (404).
   * Omis → comportement par défaut : toutes les langues publiées partagent
   * le même chemin.
   */
  alternates?: Partial<Record<Lang, string>>;
}

const {
  title,
  description,
  ogType = 'website',
  image,
  noindex = false,
  lang = 'fr',
  translated = false,
  alternates,
} = Astro.props;

const t = useTranslations(lang);

const pageTitle = title.startsWith('LIVEX') ? title : `${title} · LIVEX`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ?? new URL(url('media/og-livex.png'), Astro.site).href;

const langPath = stripLangFromPath(Astro.url.pathname);
const languages: Record<Lang, string> = { fr: 'fr', en: 'en' };
const ogLocales: Record<Lang, string> = { fr: 'fr_FR', en: 'en_US' };

function langTarget(l: Lang): string | undefined {
  if (alternates !== undefined && alternates[l] !== undefined) return alternates[l];
  if (l === lang) return langPath;
  if (alternates === undefined) return langPath;
  return undefined;
}
const langLinks: Partial<Record<Lang, string>> = {};
for (const l of publishedLangs) {
  const target = langTarget(l);
  if (target !== undefined) langLinks[l] = target;
}
const altLocales = publishedLangs
  .filter((l) => l !== lang && langLinks[l] !== undefined)
  .map((l) => ogLocales[l]);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: canonical,
  description,
  inLanguage: lang,
  license: 'https://opensource.org/licenses/MIT',
  sameAs: [SITE.repo],
};

const themeLabels = {
  dark: lang === 'en' ? 'Switch to dark theme' : 'Activer le thème sombre',
  light: lang === 'en' ? 'Switch to light theme' : 'Activer le thème clair',
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    {publishedLangs.map(
      (l) =>
        langLinks[l] !== undefined && (
          <link rel="alternate" hreflang={languages[l]} href={absoluteUrl(langLinks[l]!, l)} />
        )
    )}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(langLinks.fr ?? langPath, 'fr')} />

    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={url('site.webmanifest')} />
    <meta name="theme-color" content="#F2F2EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#090C16" media="(prefers-color-scheme: dark)" />

    <link rel="alternate" type="application/rss+xml" title="Journal LIVEX" href={url('actualites/feed.xml')} />

    <!-- Open Graph / réseaux sociaux -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="LIVEX" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {altLocales.map((loc) => <meta property="og:locale:alternate" content={loc} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={fontSerif} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontMono} as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Thème : appliqué avant le rendu pour éviter tout clignotement -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('livex-theme');
          if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">{t('nav.skip')}</a>
    {translated && (
      <div class="tnote" role="note">
        <div class="w">
          <span>{t('translation.notice')}</span>
          <a href={url(langPath, 'fr')} hreflang="fr" lang="fr">{t('translation.link')} →</a>
        </div>
      </div>
    )}
    <Header lang={lang} langLinks={langLinks} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline define:vars={{ themeLabels }}>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var root = document.documentElement;
        function update() {
          var dark = root.getAttribute('data-theme') === 'dark';
          btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
          btn.setAttribute('aria-label', dark ? themeLabels.light : themeLabels.dark);
        }
        update();
        btn.addEventListener('click', function () {
          var dark = root.getAttribute('data-theme') === 'dark';
          if (dark) root.removeAttribute('data-theme');
          else root.setAttribute('data-theme', 'dark');
          try {
            localStorage.setItem('livex-theme', dark ? 'light' : 'dark');
          } catch (e) {}
          update();
        });
      })();
    </script>
  </body>
</html>
