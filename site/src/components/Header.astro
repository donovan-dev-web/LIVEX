import { NAV, SITE } from '../data/site';
import { url } from '../utils/url';
import { useTranslations, stripLangFromPath, type Lang, publishedLangs, languages } from '../i18n/ui';
import Search from './Search.astro';
import logo from '../assets/marks/livex-mark.svg';

interface Props {
  lang?: Lang;
  /**
   * Chemin (sans préfixe de langue) de la page équivalente dans chaque langue.
   * Une langue absente de cette carte n'est pas proposée dans le sélecteur
   * (ex. page FR-only du journal). Omis → repli sur le chemin courant.
   */
  langLinks?: Partial<Record<Lang, string>>;
}
const { lang = 'fr', langLinks } = Astro.props;
const t = useTranslations(lang);

let langPath = stripLangFromPath(Astro.url.pathname);
if (langPath.startsWith('404')) langPath = '';
const current = Astro.url.pathname.replace(/\/+$/, '/');
function normalize(href: string) {
  return url(href, lang);
}
function isCurrent(href: string) {
  return current === normalize(href);
}
const langCodes: Record<Lang, string> = { fr: 'FR', en: 'EN' };
---
<header class="site">
  <div class="w hb">
    <a class="lg" href={url('', lang)} aria-label={t('nav.home')}>
      <img src={logo.src} alt="" width="24" height="24" />
      <span>LIVEX</span>
    </a>

    <nav class="main" id="main-nav" aria-label={t('nav.main')}>
      {NAV.map((item) =>
        item.children ? (
          <div class="ni">
            <button
              type="button"
              class="ni-trigger"
              aria-expanded="false"
              aria-controls={item.key + '-submenu'}
            >
              {item.label[lang]}<span class="ni-arrow" aria-hidden="true">▾</span>
            </button>
            <ul class="sub" id={item.key + '-submenu'}>
              {item.children.map((child) => (
                <li>
                  <a
                    href={url(child.href, lang)}
                    aria-current={isCurrent(child.href) ? 'page' : undefined}
                  >
                    {child.label[lang]}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a href={url(item.href, lang)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label[lang]}
          </a>
        )
      )}
      <a class="nav-cta" href={url('suivre/', lang)} aria-current={isCurrent('suivre/') ? 'page' : undefined}>
        {t('nav.follow')}
      </a>
      <a class="nav-community" href={SITE.repo + '/issues'} rel="noopener" style="font-size:0.85rem">
        {lang === 'en' ? 'Issues' : 'Issues'}
      </a>
      <a class="nav-community" href={SITE.repo + '/blob/main/SUPPORT.md'} rel="noopener" style="font-size:0.85rem">
        Support
      </a>
    </nav>

    <Search lang={lang} />

    <div class="lang" role="group" aria-label={t('nav.lang')}>
      {publishedLangs.map((code) => {
        const target = langLinks === undefined ? langPath : langLinks[code];
        return (
          target !== undefined && (
            <a
              href={url(target, code)}
              hreflang={code}
              lang={code}
              aria-current={code === lang ? 'true' : undefined}
              title={languages[code]}
            >
              {langCodes[code]}
            </a>
          )
        );
      })}
    </div>

    <button
      type="button"
      id="theme-toggle"
      aria-pressed="false"
      aria-label={t('nav.theme')}
      title={t('nav.theme')}
    >
      <span aria-hidden="true">◐</span>
      <span class="sr-only">{t('nav.theme')}</span>
    </button>

    <button
      type="button"
      id="nav-toggle"
      class="nav-burger"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label={t('nav.menu')}
      title={t('nav.menu')}
    >
      <span class="nav-burger-icon" aria-hidden="true"></span>
      <span class="sr-only">{t('nav.menu')}</span>
    </button>
  </div>
</header>

<noscript>
  <style>
    /* Sans JS, les sous-menus doivent rester accessibles (pas de bouton fonctionnel). */
    nav.main .ni { position: static; }
    nav.main .sub {
      position: static !important;
      display: flex !important;
      flex-direction: column;
      min-width: 0;
      margin: 0;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: transparent;
    }
    nav.main .sub::before { display: none; }
    nav.main .sub a { padding-left: 22px; }

    @media (max-width: 900px) {
      .nav-burger { display: none !important; }
      nav.main {
        position: static !important;
        display: flex !important;
        flex-direction: column !important;
        padding: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
      }
      nav.main > a,
      nav.main .ni > button.ni-trigger { display: block !important; padding: 10px 0 !important; border: 0 !important; }
      nav.main .sub a { padding-left: 18px !important; }
    }
  </style>
</noscript>

<script is:inline>
  (function () {
    var header = document.querySelector('header.site');
    var btn = document.getElementById('nav-toggle');
    if (!header || !btn) return;
    var mq = window.matchMedia('(min-width: 901px)');
    function set(open) {
      if (open) header.setAttribute('data-nav-open', '');
      else {
        header.removeAttribute('data-nav-open');
        header.querySelectorAll('.ni.open').forEach(function (ni) {
          ni.classList.remove('open');
          var t = ni.querySelector('.ni-trigger');
          if (t) t.setAttribute('aria-expanded', 'false');
        });
      }
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function () {
      set(!header.hasAttribute('data-nav-open'));
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var openNi = header.querySelector('.ni.open');
      if (openNi) {
        var trigger = openNi.querySelector('.ni-trigger');
        openNi.classList.remove('open');
        if (trigger) {
          trigger.setAttribute('aria-expanded', 'false');
          trigger.focus();
        }
        e.preventDefault();
        return;
      }
      if (header.hasAttribute('data-nav-open')) {
        set(false);
        btn.focus();
      }
    });
    header.querySelectorAll('nav.main a').forEach(function (a) {
      a.addEventListener('click', function () { set(false); });
    });
    header.querySelectorAll('.ni > button.ni-trigger').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var ni = btn.parentElement;
        if (!ni) return;
        var willOpen = !ni.classList.contains('open');
        header.querySelectorAll('.ni.open').forEach(function (other) {
          if (other !== ni) {
            other.classList.remove('open');
            var otherBtn = other.querySelector('.ni-trigger');
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
          }
        });
        ni.classList.toggle('open', willOpen);
        btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      });
    });
    document.addEventListener('click', function (e) {
      header.querySelectorAll('.ni.open').forEach(function (ni) {
        if (!ni.contains(e.target)) {
          ni.classList.remove('open');
          var t = ni.querySelector('.ni-trigger');
          if (t) t.setAttribute('aria-expanded', 'false');
        }
      });
      if (header.hasAttribute('data-nav-open') && !header.contains(e.target)) set(false);
    });
    mq.addEventListener('change', function (m) { if (m.matches) set(false); });
  })();
</script>
