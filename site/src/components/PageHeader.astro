import { url, absoluteUrl } from '../utils/url';
import { useTranslations, type Lang } from '../i18n/ui';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  index: string;
  eyebrow: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  lang?: Lang;
}

const { index, eyebrow, title, lead, crumbs = [], lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
const homeLabel = lang === 'en' ? 'Home' : 'Accueil';
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: absoluteUrl('', lang) },
    ...crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: c.label,
      ...(c.href ? { item: absoluteUrl(c.href, lang) } : {}),
    })),
  ],
};
---
<div class="w">
  <nav class="crumb" aria-label={t('nav.breadcrumb')}>
    <a href={url('', lang)}>{lang === 'en' ? 'Home' : 'Accueil'}</a>
    {crumbs.map((c, i) => (
      <span>
        {' · '}
        {c.href ? (
          <a href={url(c.href, lang)}>{c.label}</a>
        ) : (
          <span aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{c.label}</span>
        )}
      </span>
    ))}
  </nav>
  <section class="block" style="padding-top:26px">
    <div class="sh"><b>{index}</b> {eyebrow}</div>
    <h1 class="ptitle">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </section>
</div>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
