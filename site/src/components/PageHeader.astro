---
import { url } from '../utils/url';
import { useTranslations, type Lang } from '../i18n/ui';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  index: string;
  eyebrow: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  lang?: Lang;
}

const { index, eyebrow, title, lead, crumbs = [], lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---
<div class="w">
  <nav class="crumb" aria-label={t('nav.breadcrumb')}>
    <a href={url('', lang)}>{lang === 'en' ? 'Home' : 'Accueil'}</a>
    {crumbs.map((c) => (
      <span>
        {' · '}
        {c.href ? <a href={url(c.href, lang)}>{c.label}</a> : <span>{c.label}</span>}
      </span>
    ))}
  </nav>
  <section class="block" style="padding-top:26px">
    <div class="sh"><b>{index}</b> {eyebrow}</div>
    <h1 class="ptitle">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </section>
</div>
