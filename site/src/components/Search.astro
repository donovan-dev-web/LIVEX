import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'fr' } = Astro.props;
const t = (k: string) => (lang === 'en' ? (k === 'search' ? 'Search' : 'Close search') : (k === 'search' ? 'Rechercher' : 'Fermer la recherche'));
const pagefindBase = `${import.meta.env.BASE_URL}pagefind/`;
---

<button
  type="button"
  id="search-toggle"
  class="search-toggle"
  aria-expanded="false"
  aria-controls="search-modal"
  aria-label={t('search')}
  title={t('search')}
>
  <span aria-hidden="true">⌕</span>
  <span class="sr-only">{t('search')}</span>
</button>

<div id="search-modal" class="search-modal" hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label={t('search')}>
    <button type="button" class="search-close" data-search-close aria-label={t('close')}>✕</button>
    <div id="pagefind-search"></div>
    <p class="search-hint" data-search-dev hidden>
      {lang === 'en' ? 'Search is available on the published site.' : 'La recherche est disponible sur le site publié.'}
    </p>
  </div>
</div>

<style>
  .search-toggle {
    font: inherit;
    font-size: 0.72rem;
    background: none;
    color: var(--mu);
    border: 1px solid var(--ln);
    padding: 4px 9px;
    cursor: pointer;
    border-radius: var(--r);
  }
  .search-toggle:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 50;
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink) 40%, transparent);
  }
  .search-panel {
    position: relative;
    width: min(640px, calc(100% - 32px));
    max-height: 80vh;
    overflow-y: auto;
    margin: 8vh auto 0;
    background: var(--bg);
    border: 1px solid var(--ln);
    border-radius: var(--r);
    padding: 18px 20px 22px;
    box-shadow: 0 20px 60px color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .search-close {
    position: absolute;
    top: 6px;
    right: 8px;
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: none;
    border: 0;
    border-radius: var(--r);
    font-size: 1rem;
    cursor: pointer;
    color: var(--mu);
  }
  .search-close:hover {
    color: var(--ink);
    background: var(--gr);
  }
  .search-hint {
    font-size: 0.78rem;
    color: var(--mu);
    margin-top: 12px;
  }
  /* Pagefind UI theming to match */
  :global(.pagefind-ui) {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--ink);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--ln);
    --pagefind-ui-tag: var(--gr);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--r);
    --pagefind-ui-font: 'JetBrains Mono', ui-monospace, Menlo, monospace;
  }
</style>

<script is:inline define:vars={{ pagefindBase }}>
  (function () {
    var toggle = document.getElementById('search-toggle');
    var modal = document.getElementById('search-modal');
    if (!toggle || !modal) return;
    var loaded = false;
    var lastFocused = null;
    function open() {
      var active = document.activeElement;
      // Si rien n'était focalisé (activation au clavier, script), on rend la main au bouton.
      lastFocused = active && active !== document.body ? active : toggle;
      modal.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      var closeBtn = modal.querySelector('.search-close');
      if (closeBtn) closeBtn.focus();
      if (!loaded) {
        loaded = true;
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = pagefindBase + 'pagefind-ui.css';
        document.head.appendChild(css);
        var s = document.createElement('script');
        s.src = pagefindBase + 'pagefind-ui.js';
        s.onload = function () {
          try {
            // @ts-ignore
            new window.PagefindUI({ element: '#pagefind-search', bundlePath: pagefindBase, showSubResults: true, showImages: false });
            var input = document.querySelector('#pagefind-search input');
            if (input) input.focus();
          } catch (e) {
            var hint = document.querySelector('[data-search-dev]');
            if (hint) hint.removeAttribute('hidden');
          }
        };
        s.onerror = function () {
          var hint = document.querySelector('[data-search-dev]');
          if (hint) hint.removeAttribute('hidden');
        };
        document.head.appendChild(s);
      } else {
        var existing = document.querySelector('#pagefind-search input');
        if (existing) existing.focus();
      }
    }
    function close() {
      modal.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      else toggle.focus();
    }
    toggle.addEventListener('click', open);
    modal.querySelectorAll('[data-search-close]').forEach(function (el) {
      el.addEventListener('click', close);
    });
    document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal.hasAttribute('hidden')) open(); else close();
        return;
      }
      if (modal.hasAttribute('hidden')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      var focusables = modal.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );
      if (focusables.length === 0) return;
      var first = focusables[0];
      var last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>