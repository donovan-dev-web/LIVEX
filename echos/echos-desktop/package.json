{
  "name": "echos-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Shell Electron ECHOS — empaquette le backend Python et l'interface echos-ui (ADR-003 ECHOS).",
  "homepage": "https://github.com/donovan-dev-web/LIVEX",
  "main": "electron/main.js",
  "author": "LIVEX",
  "license": "MIT",
  "scripts": {
    "make-icon": "node scripts/make-icon.mjs",
    "build:ui": "npm --prefix ../echos-ui run build",
    "build:backend": "node scripts/build-backend.mjs",
    "start": "electron .",
    "prepare:dist": "npm run make-icon && npm run build:ui && npm run build:backend",
    "dist:linux": "npm run prepare:dist && electron-builder --linux deb",
    "dist:win": "npm run prepare:dist && electron-builder --win nsis",
    "dist": "npm run prepare:dist && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
