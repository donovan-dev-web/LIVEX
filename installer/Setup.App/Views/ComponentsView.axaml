<UserControl xmlns="https://github.com/avaloniaui"
             x:Class="Setup.App.Views.ComponentsView"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Setup.App.Localization">
  <UserControl.Resources>
    <DataTemplate x:Key="ComponentTemplate">
      <Border Classes="card" Padding="14" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanToggle}"
                    AutomationProperties.Name="{Binding Name}"
                    VerticalAlignment="Top" Margin="0,1,12,0" />
          <StackPanel Grid.Column="1" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="{Binding VersionText}" Classes="tiny" VerticalAlignment="Center" />
              <Border Background="{Binding BadgeBackground}" CornerRadius="4" Padding="6,1">
                <TextBlock Text="{Binding BadgeText}" FontSize="10" Foreground="{Binding BadgeForeground}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Description}" Classes="muted" />
            <TextBlock Text="{Binding RequiresText}" Classes="tiny" IsVisible="{Binding HasRequires}" />
            <TextBlock Text="{Binding UnavailableText}" Classes="tiny"
                       Foreground="{StaticResource BrandDanger}" IsVisible="{Binding Unavailable}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="12,2,0,0" Spacing="2" HorizontalAlignment="Right">
            <TextBlock Text="{Binding SizeText}" Classes="tiny" HorizontalAlignment="Right"
                       IsVisible="{Binding HasSize}" />
            <TextBlock Text="{Binding AcquisitionText}" Classes="tiny" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,0,0,20">
    <TextBlock Text="{l:Tr componentsIntro}" Classes="muted" />

    <StackPanel Spacing="8">
      <TextBlock Text="{l:Tr componentsCore}" Classes="h2" />
      <ItemsControl ItemsSource="{Binding CoreComponents}" ItemTemplate="{StaticResource ComponentTemplate}" />
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock Text="{l:Tr componentsBase}" Classes="h2" />
      <ItemsControl ItemsSource="{Binding BaseComponents}" ItemTemplate="{StaticResource ComponentTemplate}" />
      <Border Classes="card" Padding="12" BorderBrush="#55E8B44A" Background="#1FE8B44A"
              IsVisible="{Binding PrismWarningVisible}">
        <TextBlock Text="{l:Tr componentsPrismWarning}" Classes="muted" />
      </Border>
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock Text="{l:Tr componentsOptional}" Classes="h2" />
      <ItemsControl ItemsSource="{Binding OptionalComponents}" ItemTemplate="{StaticResource ComponentTemplate}" />
      <TextBlock Text="{l:Tr componentsNone}" Classes="tiny" IsVisible="{Binding !HasOptionalModules}" />
    </StackPanel>

    <Border Classes="inset" Padding="14">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding SelectedCountText}" Classes="h3" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding PayloadSizeText}" Classes="muted"
                   VerticalAlignment="Center" Margin="0,0,18,0" />
        <TextBlock Grid.Column="2" Text="{Binding DownloadSizeText}" Classes="muted" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
