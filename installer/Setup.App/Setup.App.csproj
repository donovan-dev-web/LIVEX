<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseAvalonia>true</UseAvalonia>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\livex-app-icon.ico</ApplicationIcon>
    <AssemblyName>livex-setup</AssemblyName>
    <RootNamespace>Setup.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.Svg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Setup.Core\Setup.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>