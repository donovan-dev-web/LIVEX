<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseAvalonia>true</UseAvalonia>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\livex-app-icon.ico</ApplicationIcon>
    <AssemblyName>livex-setup</AssemblyName>
    <RootNamespace>Setup.App</RootNamespace>

    <!--
      L'installateur est copié seul dans l'installation (racine) pour permettre
      la désinstallation sans retéléchargement : il doit donc être autonome.
      Ces propriétés ne s'appliquent qu'à une publication avec RID.
    -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.Svg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Setup.Core\Setup.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>