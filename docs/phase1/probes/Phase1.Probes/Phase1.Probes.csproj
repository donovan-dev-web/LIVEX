<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Cible alignée sur Simulation.Core de la base 707f86c (net10.0).
      NB: la consigne parlait de « net8.0 (matching global.json) », mais le
      global.json de la base épingle le SDK 10.0.400 et Simulation.Core cible
      net10.0. Un projet net8.0 ne peut PAS référencer un projet net10.0
      (incompatibilité de TFM) : les sondes ne seraient pas exécutables. On cible
      donc net10.0.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Phase1.Probes</RootNamespace>
    <AssemblyName>Phase1.Probes</AssemblyName>
  </PropertyGroup>

  <!--
    Résolution du projet Simulation.Core selon l'emplacement de la copie :
      - docs/phase1/probes/Phase1.Probes (branche realignement) -> ..\..\..\..\syne\Simulation.Core
      - syne/Phase1.Probes               (copie base 707f86c)  -> ..\Simulation.Core
    Le premier chemin qui existe gagne ; repli sur le voisin immédiat.
  -->
  <PropertyGroup>
    <SimulationCoreProject Condition="Exists('..\..\..\..\syne\Simulation.Core\Simulation.Core.csproj')">..\..\..\..\syne\Simulation.Core\Simulation.Core.csproj</SimulationCoreProject>
    <SimulationCoreProject Condition="'$(SimulationCoreProject)' == ''">..\Simulation.Core\Simulation.Core.csproj</SimulationCoreProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SimulationCoreProject)" />
  </ItemGroup>

</Project>
