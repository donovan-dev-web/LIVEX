<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.Presentation.ViewModel"
        x:Class="Launcher.App.Views.ConsoleWindow"
        x:DataType="vm:ConsoleViewModel"
        Title="{Binding Title}"
        Width="1120" Height="680"
        MinWidth="640" MinHeight="360"
        FontFamily="Inter, Segoe UI, Ubuntu, sans-serif"
        Background="#070a0f">

  <!-- Console de composant (USER_INTERFACE.md §9) : sortie brute, monospace, deux canaux colorés. -->
  <Window.Styles>
    <Style Selector="TextBlock.h-console">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="#e8e6e1"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9aa0aa"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style Selector="Button.btn">
      <Setter Property="Background" Value="#12151d"/>
      <Setter Property="BorderBrush" Value="#3a3f4a"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="#e8e6e1"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1a1f29"/>
    </Style>
    <Style Selector="Button.btn:disabled">
      <Setter Property="Opacity" Value="0.42"/>
    </Style>
    <Style Selector="ToggleButton.btn">
      <Setter Property="Background" Value="#12151d"/>
      <Setter Property="BorderBrush" Value="#3a3f4a"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="#9aa0aa"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleButton.btn:checked">
      <Setter Property="Background" Value="#1d2733"/>
      <Setter Property="BorderBrush" Value="#2d9bf0"/>
      <Setter Property="Foreground" Value="#e8e6e1"/>
    </Style>
    <Style Selector="ToggleButton.btn /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ListBox.lines">
      <Setter Property="Background" Value="#080b10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style Selector="ListBox.lines ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,1"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ListBox.lines ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0e131b"/>
    </Style>
    <Style Selector="ListBox.lines ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#16202c"/>
    </Style>
    <Style Selector="Border.chan">
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="5,1"/>
      <Setter Property="MinWidth" Value="52"/>
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Barre d'outils : pause, effacer, canaux, défilement, journaux. -->
    <Border DockPanel.Dock="Top" Background="#0b0f16" BorderBrush="#262b34" BorderThickness="0,0,0,1" Padding="14,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="CONSOLE" Classes="h-console" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Title}" Classes="muted" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="btn" Content="{Binding PauseLabel}" Command="{Binding ActionCommand}" CommandParameter="pause"/>
          <Button Classes="btn" Content="Effacer" Command="{Binding ActionCommand}" CommandParameter="clear"/>
          <ToggleButton Classes="btn" Content="stdout" IsChecked="{Binding ShowStdout, Mode=TwoWay}"/>
          <ToggleButton Classes="btn" Content="stderr" IsChecked="{Binding ShowStderr, Mode=TwoWay}"/>
          <ToggleButton Classes="btn" Content="Suivre" IsChecked="{Binding AutoScroll, Mode=TwoWay}"/>
          <Button Classes="btn" Content="Journaux" Click="OnOpenLogsDirectoryClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Pied : compte-rendu factuel, sans interprétation. -->
    <Border DockPanel.Dock="Bottom" Background="#0b0f16" BorderBrush="#262b34" BorderThickness="0,1,0,0" Padding="14,7">
      <TextBlock Text="{Binding StatusText}" Classes="muted"/>
    </Border>

    <!-- Flux de lignes : virtuellement, le défilement suit la dernière ligne reçue. -->
    <ListBox x:Name="LinesList" Classes="lines" ItemsSource="{Binding Lines}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ConsoleLineViewModel">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Timestamp}" Foreground="#5f6875" FontSize="11.5"
                       FontFamily="Cascadia Code, Consolas, DejaVu Sans Mono, monospace" VerticalAlignment="Center"/>
            <Border Classes="chan" Background="#101820" VerticalAlignment="Center">
              <TextBlock Text="{Binding Stream}" FontSize="10.5" Foreground="#2d9bf0"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="NoWrap"
                       Foreground="#e05252"
                       FontFamily="Cascadia Code, Consolas, DejaVu Sans Mono, monospace"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsError}"/>
            <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="NoWrap"
                       Foreground="#d7dbe2"
                       FontFamily="Cascadia Code, Consolas, DejaVu Sans Mono, monospace"
                       VerticalAlignment="Center"
                       IsVisible="{Binding !IsError}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
