{
  "schema": 1,
  "id": "example-worker",
  "name": "Example worker",
  "type": "utility",
  "version": "1.0.0",
  "runtime": "native",
  "executable": {
    "path": "bin/worker"
  },
  "workingDirectory": ".",
  "endpoints": {
    "control": {
      "transport": "http"
    },
    "observability": {
      "transport": "websocket",
      "launchArgument": "--data-port"
    }
  },
  "capabilities": [
    "headless",
    "observability"
  ],
  "health": {
    "probe": "http",
    "path": "/health/ready",
    "intervalMs": 1000
  },
  "timeouts": {
    "startupMs": 30000,
    "shutdownMs": 5000
  },
  "contributesTo": [],
  "requires": []
}
